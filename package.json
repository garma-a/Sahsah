{
  "name": "sahsah",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.3",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "install:prototype": "npx --yes pnpm@10.34.3 --dir sahsah_prototype install --frozen-lockfile",
    "install:web": "npx --yes pnpm@10.34.3 --dir web_app install --frozen-lockfile",
    "dev": "npm --prefix sahsah_prototype run dev --",
    "build": "npm --prefix sahsah_prototype run build --",
    "preview": "npm --prefix sahsah_prototype run preview --",
    "start": "npm --prefix sahsah_prototype run start --",
    "check": "npm --prefix sahsah_prototype run check",
    "test": "npm --prefix sahsah_prototype run test",
    "test:browser": "npm --prefix sahsah_prototype run test:browser",
    "test:demo": "npm --prefix sahsah_prototype run test:demo",
    "format": "npm --prefix sahsah_prototype run format --",
    "dev:web": "npm --prefix web_app run dev",
    "dev:frontend": "npm --prefix web_app/frontend run dev",
    "dev:backend": "npm --prefix web_app/backend run dev",
    "dev:admin": "npm --prefix web_app/adminJS run dev",
    "build:web": "npm --prefix web_app run build",
    "check:web": "npm --prefix web_app run check"
  }
}
