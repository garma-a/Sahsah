<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash: the app icon on a colour. Make
         that the charcoal, in light and dark mode alike. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_charcoal</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_charcoal</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_charcoal</item>
    </style>
</resources>
