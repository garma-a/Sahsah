<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: the logo on charcoal, as the
     app opens (Android 12+ shows the icon instead, see values-v31). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_charcoal" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
