Project sahsah {
  database_type: 'PostgreSQL'
  Note: '''
    Working design v0.9, 2026-10-27: retained history and financial integration draft.
    This is an incomplete interview artifact, not a production migration.
    UUID keys and the concrete column names/types below are proposed technical choices.
    Launch domains are represented; final policy answers, PostgreSQL-only rules and
    scenario/index review still precede design sign-off. No runtime is implemented.
    Orders are single token purchases; there is no multi-product basket at launch.
    Players have one nonexpiring bank with no cash-out/purchase-refund feature.
    Do not add source-lot spending, refund reservations or FIFO bookkeeping.
    Public packs remain editable after warning/confirmation. Game question snapshots
    preserve starting content; no immutable-publication restriction is imposed.
    Logical question identity survives edits; replacement creates a new identity.
  '''
}

Enum game_status {
  active
  finished
  expired
  failed
}

Enum game_end_reason {
  completed
  host_ended
  host_left
  idle_timeout
  platform_failure
}

Enum token_entry_kind {
  credit
  game_debit
  game_restoration
  deletion_forfeiture
}

Enum game_restoration_reason {
  unopened_game
  platform_failure
}

Enum token_order_kind {
  personal
  gift
}

Enum applied_discount_kind {
  none
  gift
  promo_code
}

Enum order_payment_state {
  pending
  paid
  not_required
  cancelled
}

Enum promo_usage_state {
  held
  consumed
  released
}

Enum question_timer_state {
  ready
  running
  paused
  elapsed
}

Enum score_entry_kind {
  question_award
  manual_adjustment
}

Enum pack_publication_state {
  draft
  published
}

Enum question_format {
  STANDARD
  IMAGE_BLUR
  IMAGE_ZOOM
  AUDIO_GUESS
  AUDIO_REVERSE
  IMAGE_PERSON
  IMAGE_COLOR
  IMAGE_RIDDLE
  AUDIO_VOICE
  IMAGE_MEMORY
}

Enum media_kind {
  image
  audio
}

Enum media_asset_state {
  pending
  ready
  failed
}

Enum question_media_role {
  prompt_image
  answer_image
  source_image
  question_audio
  source_audio
  answer_audio
  hint_image
}

Enum account_state {
  active
  deletion_pending
  deleted
}

Enum player_locale {
  ar
  franco
}

Enum phone_verification_purpose {
  sign_in
  phone_change_old
  phone_change_new
}

Enum promotion_trigger {
  code
  automatic_free
}

Enum payment_environment {
  test
  live
}

Enum payment_attempt_state {
  initializing
  ready
  unknown
  closed_unpaid
  paid
}

Enum provider_reference_kind {
  intention
  order
}

Enum payment_outcome {
  pending
  authorized
  succeeded
  failed
  voided
}

Enum payment_receipt_state {
  queued
  processed
  needs_review
  ignored
}

Enum settlement_kind {
  payment
  zero_cost
}

Enum reconciliation_state {
  open
  resolved
}

Enum payment_verification_method {
  hmac_callback
  authenticated_inquiry
}

Enum payment_transaction_kind {
  payment
  capture
  refund
  void
}

Enum deletion_request_state {
  requested
  confirmed
  completed
  cancelled
}

Enum feedback_vote {
  like
  dislike
}

Enum contact_kind {
  support
  experience
  business
}

Enum contact_state {
  open
  closed
}

Enum work_state {
  pending
  running
  succeeded
  dead
}

Enum media_access_scope {
  private
  public
}

Table categories {
  id uuid [pk]
  name_ar text [not null]
  name_franco text
  display_order integer [not null, default: 0]
  archived_at timestamptz

  checks {
    `display_order >= 0` [name: 'categories_display_order_bounds']
  }

  Note: 'A selectable grouping containing authored six-question packs. Order by display_order/id; about twenty categories need no extra sort-only index. Archived categories hide all their packs from new games without rewriting pack publication/archival state. Restoration exposes otherwise playable packs again; existing games retain copied content.'
}

Table question_packs {
  id uuid [pk]
  category_id uuid [not null]
  pack_number integer [not null]
  content_revision bigint [not null, default: 1]
  publication_state pack_publication_state [not null, default: 'draft']
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category_id, pack_number) [unique, name: 'question_packs_category_number']
  }

  checks {
    `pack_number > 0 AND content_revision > 0` [name: 'question_packs_positive_number_revision']
    `updated_at >= created_at` [name: 'question_packs_update_order']
  }

  Note: '''
    A stable authored pack belongs to one category. It is included through game tokens,
    not sold as an additional product. Stable per-category positive pack numbers are
    display labels, never per-user random mappings or global identity. Allocate under
    the category lock; retain archived numbers. Category/number uniqueness also serves
    ordered category lists, replacing a redundant category/id index. content_revision
    advances for any accepted pack/question/stage/media edit and supports stale-editor
    detection; it does not classify ordinary typo edits as new unseen questions.
    Staff can edit published content after a warning and confirmation. New games use
    its current six slots; existing games use their copied question snapshots.
    Incomplete drafts are allowed. A playable published pack must contain six valid
    questions and ready required media; publication and public edits validate/save
    the complete set atomically under the pack lock. No reviewer approval is required.
    CHECKs cannot prove six rows or media readiness. An archived pack/category is
    excluded from new games while existing games/progress remain intact. Restoring
    a pack does not bypass its current six-question/media publication validation.
  '''
}

Table questions {
  id uuid [pk]
  pack_id uuid [not null]
  prompt_ar text [not null]
  prompt_franco text
  answer_ar text [not null]
  answer_franco text
  format question_format [not null]
  format_config jsonb [not null, default: `'{}'::jsonb`]
  retired_at timestamptz

  indexes {
    (pack_id, id) [unique, name: 'questions_pack_identity']
  }

  checks {
    `jsonb_typeof(format_config) = 'object'` [name: 'questions_format_config_object']
  }

  Note: '''
    A question record belongs to one pack. Staff manually review duplicate content;
    there is intentionally no unique text/hash constraint or automatic duplicate detector.
    Current membership is held in pack_questions. Replacement retires the previous
    identity and assigns a new one to that slot, preserving prior exposure/history.
    Retirement is a proposed retention mechanism; final deletion policies are pending.
    Each question owns one of ten formats; a pack can mix them. Arabic prompt/answer
    must be nonblank before publication. Missing optional Franco fields fall back
    independently to Arabic; normalize blank optional values to NULL on write.
    Strict format-specific config schemas cover crop/focal/color/voice/reverse flags;
    do not accept arbitrary media URLs or credentials inside this JSON object.
    Media roles and hint stages are relational. A format change preserves logical
    identity only when staff intend an edit rather than explicit replacement.
  '''
}

Table pack_questions {
  pack_id uuid [not null]
  slot_number smallint [not null]
  question_id uuid [not null]

  indexes {
    (pack_id, slot_number) [pk, name: 'pack_questions_slot']
    question_id [unique, name: 'pack_questions_current_question']
  }

  checks {
    `slot_number BETWEEN 1 AND 6` [name: 'pack_questions_slot_bounds']
  }

  Note: '''
    The six current slots of an authored pack. Separate slot membership permits staff
    to replace a question while retaining the previous identity for history. Composite
    membership ensures the current question belongs to the pack. Bounds/uniqueness
    provide at most six; initial publication and edits to a public pack must save a
    valid six-slot set atomically. This is content validation, not a review/publish gate.
  '''
}

Table media_assets {
  id uuid [pk]
  media_kind media_kind [not null]
  state media_asset_state [not null, default: 'pending']
  access_scope media_access_scope [not null, default: 'private']
  storage_provider text [not null]
  storage_namespace text [not null]
  storage_key text [not null]
  content_type text
  byte_size bigint
  width_px integer
  height_px integer
  duration_ms integer
  sha256 bytea
  source_asset_id uuid
  transform_spec jsonb [not null, default: `'{}'::jsonb`]
  uploaded_by_staff_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  ready_at timestamptz
  archived_at timestamptz

  indexes {
    (storage_provider, storage_namespace, storage_key) [unique, name: 'media_assets_storage_identity']
    (source_asset_id, id) [name: 'media_assets_derivatives']
  }

  checks {
    `length(btrim(storage_provider)) > 0 AND octet_length(storage_provider) <= 32` [name: 'media_assets_provider_bounds']
    `length(btrim(storage_namespace)) > 0 AND octet_length(storage_namespace) <= 128` [name: 'media_assets_namespace_bounds']
    `length(btrim(storage_key)) > 0 AND octet_length(storage_key) <= 1024` [name: 'media_assets_key_bounds']
    `(state = 'ready') = (ready_at IS NOT NULL)` [name: 'media_assets_ready_time_pair']
    `ready_at IS NULL OR ready_at >= created_at` [name: 'media_assets_ready_order']
    `byte_size IS NULL OR byte_size > 0` [name: 'media_assets_positive_bytes']
    `(width_px IS NULL) = (height_px IS NULL)` [name: 'media_assets_dimension_pair']
    `width_px IS NULL OR (width_px > 0 AND height_px > 0)` [name: 'media_assets_positive_dimensions']
    `duration_ms IS NULL OR duration_ms > 0` [name: 'media_assets_positive_duration']
    `sha256 IS NULL OR octet_length(sha256) = 32` [name: 'media_assets_checksum_shape']
    `source_asset_id IS NULL OR source_asset_id <> id` [name: 'media_assets_no_direct_self_source']
    `jsonb_typeof(transform_spec) = 'object'` [name: 'media_assets_transform_object']
    `state <> 'ready' OR (content_type IS NOT NULL AND byte_size IS NOT NULL AND ((media_kind = 'image' AND left(content_type, 6) = 'image/' AND width_px IS NOT NULL AND height_px IS NOT NULL AND duration_ms IS NULL) OR (media_kind = 'audio' AND left(content_type, 6) = 'audio/' AND duration_ms IS NOT NULL AND width_px IS NULL AND height_px IS NULL)))` [name: 'media_assets_ready_metadata']
  }

  Note: '''
    One immutable physical image/audio object per upload or generated rendition;
    bytes live in Cloudflare, not PostgreSQL. Storage adapter/namespace/key are durable
    private references, never signed URLs. Backend selection/credentials are deployment
    configuration, not embedded in question JSON. Allocate server-controlled fresh keys
    for every revision/variant and prevent overwriting ready bytes. Required metadata
    becomes authoritative only after byte/type/dimension/duration validation.
    Reuse one asset in many questions; there is no unique checksum or semantic question
    duplication rule. Derived assets reference their retained source with a bounded,
    versioned transform spec. Source acyclicity and correct media-kind roles are write
    validation. Archive hides from new authoring, not deletion of objects used by games.
    Durable processing/retry leases use outbox_events; retention/cleanup handlers
    recheck references and readiness before changing metadata or deleting objects.
  '''
}

Table question_media {
  question_id uuid [not null]
  media_role question_media_role [not null]
  media_asset_id uuid [not null]

  indexes {
    (question_id, media_role) [pk, name: 'question_media_role_identity']
    (media_asset_id, question_id) [name: 'question_media_asset_references']
  }

  checks {
    `media_role <> 'hint_image'` [name: 'question_media_stages_separate']
  }

  Note: '''
    Current authoring roles: optional ordinary prompt/answer images, required mode
    images/audio and private originals. One asset can occupy several roles. Blur/zoom
    stage images belong to question_hint_stages. Validate role/kind and required ready
    media by format at publication. Originals stay private; answer-only image/forward
    speech is released only when allowed after reveal. This table grants no public URL.
  '''
}

Table question_hint_stages {
  question_id uuid [not null]
  stage_index smallint [not null]
  suggested_points smallint [not null]
  media_asset_id uuid [not null]

  indexes {
    (question_id, stage_index) [pk, name: 'question_hint_stages_identity']
    (media_asset_id, question_id) [name: 'question_hint_stages_asset_references']
  }

  checks {
    `stage_index BETWEEN 0 AND 2` [name: 'question_hint_stages_index_bounds']
    `suggested_points BETWEEN 1 AND 600` [name: 'question_hint_stages_positive_points']
  }

  Note: '''
    Three authored blur/zoom stages, with editable positive strictly decreasing points.
    Defaults: 600/400/200, 400/250/150 or 200/150/50. Publication requires exactly three,
    first value equal to the owning current slot's tile cap, descending points and
    ready image variants with valid blur/zoom transformations. PK/bounds prove at most
    three, not sequence/completeness/cap. Other formats have no hint-stage rows.
    Game start copies ordered stage rules and pins the exact image assets; catalog
    edits cannot alter the game's stages. Host award override still uses original cap.
  '''
}

Table game_question_media {
  game_id uuid [not null]
  board_position smallint [not null]
  question_position smallint [not null]
  media_role question_media_role [not null]
  variant_number smallint [not null, default: 0]
  media_asset_id uuid [not null]

  indexes {
    (game_id, board_position, question_position, media_role, variant_number) [pk, name: 'game_question_media_identity']
    (media_asset_id, game_id) [name: 'game_question_media_asset_references']
  }

  checks {
    `(media_role = 'hint_image' AND variant_number BETWEEN 0 AND 2) OR (media_role <> 'hint_image' AND variant_number = 0)` [name: 'game_question_media_variant_role']
  }

  Note: '''
    Immutable relational pins for every starting snapshot asset, including private
    originals, answer-only media and three numbered hint images. These FKs support
    retention/garbage-collection checks that opaque JSON references cannot provide.
    Copy with the 36 starting snapshots and validate role/assets against the typed
    snapshot. A media response checks membership, active question, stage, reveal and
    memory visibility before issuing a short-lived delivery URL. Never send private
    source or unrevealed variants in a public snapshot. Ready assets/keys remain
    unchanged while any retained catalog, derivative or game reference needs them.
    Exact retention windows and emergency takedown rules remain open.
  '''
}

Table rooms {
  id uuid [pk]
  owner_account_id uuid [not null]
  current_game_id uuid
  lobby_generation integer [not null, default: 1]
  team_one_name text [not null]
  team_two_name text [not null]
  created_at timestamptz [not null, default: `now()`]
  closed_at timestamptz

  checks {
    `lobby_generation > 0` [name: 'rooms_positive_lobby_generation']
    `length(btrim(team_one_name)) > 0 AND length(btrim(team_two_name)) > 0` [name: 'rooms_nonblank_team_names']
    `closed_at IS NULL OR closed_at >= created_at` [name: 'rooms_close_order']
  }

  Note: '''
    Reusable invitation/lobby owned by the same signed-in host; no host transfer.
    current_game_id points to this room's latest game, active or terminal. A terminal
    pointer does not prevent preparing a replay. Lobby team names are copied into
    each game's two scoring teams. Invitation expiry is separate from room/game life.
    At most six current members including host: join/start lock this room, enforce
    capacity and prevent admission to an active game's frozen roster. Network loss
    does not free a seat. Every start uses the current lobby generation, then advances
    it in the same transaction, invalidating previous Ready confirmations. Game ending
    need not acquire the room lock merely to reset readiness. Game commands must not
    take the room lock after locking a game; see invitation transaction notes.
    Device connections are not additional people or PostgreSQL connections.
  '''
}

Table room_invitations {
  id uuid [pk]
  room_id uuid [not null]
  code char(6) [not null]
  issued_by_account_id uuid [not null]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz

  indexes {
    (id, room_id, code) [unique, name: 'room_invitations_registry_identity']
    (room_id, issued_at, id) [name: 'room_invitations_room_history']
    (expires_at, id) [name: 'room_invitations_expiry_cleanup']
  }

  checks {
    `code ~ '^[0-9]{6}$'` [name: 'room_invitations_six_digits']
    `expires_at = issued_at + interval '24 hours'` [name: 'room_invitations_fixed_lifetime']
    `revoked_at IS NULL OR revoked_at >= issued_at` [name: 'room_invitations_revocation_order']
  }

  Note: '''
    Historical issuance of a six-digit room code; preserve leading zeros as text.
    Issuer must be room owner, checked under the room lock. A code is usable only if
    its registry row still points here, the room admits new members, it is unrevoked
    and a fresh clock is before expires_at. Expiry affects admission only. Replay
    reuses a valid invitation or issues another; rotation revokes old admission.
    Never reissue an expired code by reviving this row: create a fresh invitation ID.
    Historical codes can repeat; live uniqueness belongs to room_invitation_codes.
  '''
}

Table room_invitation_codes {
  code char(6) [pk]
  invitation_id uuid [not null, unique]
  room_id uuid [not null, unique]

  Note: '''
    Small current-code registry: one code maps to exactly one invitation/room, and a
    room has at most one registered code. Composite FK prevents mismatched code/room.
    A registry entry alone does not establish unexpired admission. Reclaim only after
    locking/rechecking the previous issuance with fresh time; retire the old registry
    row and issue the new one atomically. Never use a now()-dependent index predicate.
    Rotation and join serialize on the room; same-code races serialize on this PK.
    Continuing members authenticate independently of this locator, so rotation/reuse
    never redirects their saved reconnect credential into another room.
  '''
}

Table room_memberships {
  id uuid [pk]
  room_id uuid [not null]
  account_id uuid
  display_name text [not null]
  lobby_team_number smallint
  ready_for_generation integer
  ready_at timestamptz
  joined_at timestamptz [not null]
  left_at timestamptz
  removed_at timestamptz

  indexes {
    (room_id, id) [unique, name: 'room_memberships_room_identity']
    (account_id, room_id) [name: 'room_memberships_account_recovery']
  }

  checks {
    `length(btrim(display_name)) > 0` [name: 'room_memberships_nonblank_name']
    `lobby_team_number IS NULL OR lobby_team_number IN (1, 2)` [name: 'room_memberships_team_bounds']
    `(ready_for_generation IS NULL) = (ready_at IS NULL)` [name: 'room_memberships_ready_pair']
    `ready_for_generation IS NULL OR ready_for_generation > 0` [name: 'room_memberships_ready_generation']
    `ready_at IS NULL OR ready_at >= joined_at` [name: 'room_memberships_ready_order']
    `left_at IS NULL OR left_at >= joined_at` [name: 'room_memberships_leave_order']
    `removed_at IS NULL OR removed_at >= joined_at` [name: 'room_memberships_removal_order']
  }

  Note: '''
    Room-level participant identity and next-game lobby preferences, separate from
    frozen game_players. Immediate admission requires valid invitation, name/team
    and capacity under the room lock; host may be neutral. At most six current people
    including host. Add a PostgreSQL partial unique active (room_id, account_id) key
    for nonnull accounts with left_at/removed_at null; DBML does not encode it.
    Signed-in recovery uses verified account identity. Anonymous recovery uses its
    private credential, not name/code/device fingerprint. A guest can bind an account
    for a later game's lobby, never retroactively update an existing game snapshot.
    Each non-host must Ready for rooms.lobby_generation before start. Preserve names/
    teams across replay; changing the member's team clears that readiness. Host removal
    is pre-start only, revokes credentials and cannot delete historical game seats.
    Rejoin/block rules after removal and room cleanup retention remain to settle.
  '''
}

Table room_member_credentials {
  room_member_id uuid [pk]
  credential_hash bytea [not null, unique]
  issued_at timestamptz [not null]
  revoked_at timestamptz

  checks {
    `octet_length(credential_hash) = 32` [name: 'room_member_credentials_hash_shape']
    `revoked_at IS NULL OR revoked_at >= issued_at` [name: 'room_member_credentials_revocation_order']
  }

  Note: '''
    One current high-entropy anonymous reconnect credential, persisted by the client
    and stored only as a hash. Refresh/restart reuses the membership and seat; lost
    credentials cannot be recovered by name/code or transferred to a new device at
    launch. A signed-in member can recover after account authentication. Every state
    read/command also checks room/membership/game eligibility and any revocation.
    Leave/removal revokes immediately. Explicit expiry/cleanup follows retention design;
    invitation expiry alone does not revoke this credential. No plaintext secrets or
    client-controlled device IDs are treated as proof of membership.
  '''
}

Table games {
  id uuid [pk]
  room_id uuid [not null]
  sequence_number integer [not null]
  status game_status [not null, default: 'active']
  state_version bigint [not null, default: 0]
  start_request_id uuid [not null, unique]
  start_request_digest bytea [not null]
  started_at timestamptz [not null]
  ended_at timestamptz
  end_reason game_end_reason
  last_gameplay_at timestamptz [not null]
  idle_expires_at timestamptz [not null]
  first_question_opened_at timestamptz
  content_purge_after timestamptz
  content_purged_at timestamptz

  indexes {
    (id, room_id) [unique, name: 'games_room_membership_identity']
    (room_id, sequence_number) [unique, name: 'games_room_sequence']
    (status, idle_expires_at, id) [name: 'games_due_expiry']
    (content_purged_at, content_purge_after, id) [name: 'games_due_content_purge']
  }

  checks {
    `sequence_number > 0` [name: 'games_positive_sequence']
    `state_version >= 0` [name: 'games_nonnegative_version']
    `octet_length(start_request_digest) = 32` [name: 'games_start_request_digest_shape']
    `(status IN ('finished', 'expired', 'failed')) = (ended_at IS NOT NULL)` [name: 'games_terminal_time']
    `(ended_at IS NULL) = (end_reason IS NULL)` [name: 'games_end_reason_pair']
    `last_gameplay_at >= started_at` [name: 'games_activity_order']
    `ended_at IS NULL OR ended_at >= last_gameplay_at` [name: 'games_end_order']
    `idle_expires_at = last_gameplay_at + interval '24 hours'` [name: 'games_fixed_idle_window']
    `end_reason IS NULL OR (status = 'finished' AND end_reason IN ('completed', 'host_ended', 'host_left')) OR (status = 'expired' AND end_reason = 'idle_timeout') OR (status = 'failed' AND end_reason = 'platform_failure')` [name: 'games_reason_matches_state']
    `status <> 'expired' OR ended_at = idle_expires_at` [name: 'games_effective_expiry_time']
    `first_question_opened_at IS NULL OR (started_at IS NOT NULL AND first_question_opened_at >= started_at AND (ended_at IS NULL OR first_question_opened_at <= ended_at))` [name: 'games_first_open_time']
    `end_reason IS DISTINCT FROM 'completed' OR first_question_opened_at IS NOT NULL` [name: 'games_completion_requires_opening']
    `(ended_at IS NULL) = (content_purge_after IS NULL)` [name: 'games_content_retention_presence']
    `content_purge_after IS NULL OR content_purge_after = ended_at + interval '12 months'` [name: 'games_content_retention_window']
    `content_purged_at IS NULL OR (content_purge_after IS NOT NULL AND content_purged_at >= content_purge_after)` [name: 'games_content_purge_order']
  }

  Note: '''
    One ACCEPTED started play inside a reusable room; unpaid lobbies live on rooms,
    not on another game state. Failed/rejected start creates no game/debit. Replay
    creates another game. start_request_id/digest durably bind accepted start retries
    to this exact game/payload even after generic command receipts are cleaned up.
    Verify authenticated owner before returning an existing start result.
    Explicit host leave
    or End game finalizes it for everyone; app closure/disconnection preserves resume
    before expiry. Started games expire 24 elapsed hours after meaningful host gameplay
    activity. Reconnect, reads, heartbeats and controller takeover alone do not extend
    that window. Closed/expired games cannot resume. Cleanup releases matching account
    claims and restores one token if no question ever opened. first_question_opened_at
    is set once with the first accepted opening and must never be cleared by reset or
    return-to-board. These transition/immutability rules require serialized write paths;
    CHECKs do not perform timed expiry or validate old/new row transitions. An expired
    row stores its effective deadline as ended_at, even if worker processing is later.
    Pre-start lobby cleanup remains separate. The 36th resolution automatically
    finishes and locks scores; no final-review phase or post-end corrections. Overall
    corrections before ending preserve question awards and category badges.
    Sequence allocation is transactional, not unprotected MAX + 1.
    Full copied text/media is retained for 12 months after ending, then a controlled
    purge removes payloads/media pins while preserving IDs, results and progress.
    The purge marker is set only after all related cleanup commits. Current catalog
    references remain valid and do not expire with old game content.
  '''
}

Table game_packs {
  game_id uuid [not null]
  category_id uuid [not null]
  pack_id uuid [not null]
  board_position smallint [not null]
  pack_number integer [not null]
  source_content_revision bigint [not null]
  category_name_ar text [not null]
  category_name_franco text
  repeat_accepted_at timestamptz
  repeat_accepted_by_seat smallint

  indexes {
    (game_id, board_position) [pk, name: 'game_packs_position']
    (game_id, category_id) [unique, name: 'game_packs_distinct_categories']
  }

  checks {
    `board_position BETWEEN 1 AND 6` [name: 'game_packs_position_bounds']
    `pack_number > 0 AND source_content_revision > 0` [name: 'game_packs_source_revision_bounds']
    `(repeat_accepted_at IS NULL) = (repeat_accepted_by_seat IS NULL)` [name: 'game_packs_repeat_consent_pair']
  }

  Note: '''
    One chosen pack for each of six distinct category columns. Category/pack membership
    is validated against the current catalog in the game-start transaction and then
    preserved as historical data; it is not tied to later catalog reassignment by a
    composite FK. Bounds/uniqueness alone do not ensure six columns: game start must
    validate all six packs and copy all 36 questions. Repeat consent records a host
    decision for the selected game content and fixed roster; host authorization and
    consent validity are application transaction rules, not supplied by the actor FK.
  '''
}

Table game_question_slots {
  game_id uuid [not null]
  board_position smallint [not null]
  question_position smallint [not null]
  source_question_id uuid [not null]
  base_points smallint [not null]
  format question_format [not null]
  snapshot_schema_version smallint [not null, default: 1]
  content_snapshot jsonb
  content_purged_at timestamptz

  indexes {
    (game_id, board_position, question_position) [pk, name: 'game_question_slots_position']
    (game_id, source_question_id) [unique, name: 'game_question_slots_distinct_question']
  }

  checks {
    `question_position BETWEEN 1 AND 6` [name: 'game_question_slots_question_bounds']
    `base_points = CASE WHEN question_position IN (1, 2) THEN 200 WHEN question_position IN (3, 4) THEN 400 ELSE 600 END` [name: 'game_question_slots_point_band']
    `snapshot_schema_version > 0` [name: 'game_question_slots_schema_version']
    `jsonb_typeof(content_snapshot) = 'object'` [name: 'game_question_slots_snapshot_object']
    `(content_snapshot IS NULL) = (content_purged_at IS NOT NULL)` [name: 'game_question_slots_content_presence']
  }

  Note: '''
    Immutable content copied when this game starts, including prompt/answer locales,
    format settings, stage rules and version-specific media references. Store metadata
    and retained asset identities/keys, not image bytes or expiring signed URLs.
    Answers and unrevealed media are private server data; public projections require
    reveal authorization. Typed formats, media pins and 12-month content retention
    are modeled. Snapshot immutability is enforced by write paths/future DDL;
    a JSON object check alone does not validate the payload. Runtime progress, timer,
    reveal, scores and adjudication are intentionally not embedded in this snapshot.
    Null payload is permitted only for a marked retention purge after the terminal
    game's 12-month deadline, never for an accepted start/resume. Keep source identity,
    format and base points after purge; do not reconstruct old text from edited catalog.
  '''
}

Table game_teams {
  game_id uuid [not null]
  team_number smallint [not null]
  display_name text [not null]
  current_score bigint [not null, default: 0]

  indexes {
    (game_id, team_number) [pk, name: 'game_teams_identity']
  }

  checks {
    `team_number IN (1, 2)` [name: 'game_teams_number_bounds']
    `length(btrim(display_name)) > 0` [name: 'game_teams_nonblank_name']
    `current_score >= 0` [name: 'game_teams_nonnegative_score']
  }

  Note: '''
    Two game-specific competing sides, not reusable clubs or account-owned teams.
    Create both rows with the game; bounds alone establish at most two. Scores are
    rebuildable projections of append-only game_score_entries and must change in
    the same serialized transaction as the entry. No minimum connected membership
    per side is required. The host may be neutral; guest teams are set before start.
    Scores lock when the root game ends; actor/state checks belong to the write path.
    No name uniqueness is implied. bigint is a proposed technical storage range,
    not an agreed product score cap; API integer validation remains required.
  '''
}

Table game_runtime {
  game_id uuid [pk]
  active_board_position smallint
  active_question_position smallint

  checks {
    `(active_board_position IS NULL) = (active_question_position IS NULL)` [name: 'game_runtime_active_pointer_pair']
  }

  Note: '''
    One current question pointer for the host-controlled game. Both positions null
    means the board; game status determines terminal presentation. Unpaid lobbies
    belong to rooms and do not create another game status.
    The composite FK binds a selected question to this game's runtime row. Create
    once at start. A serialized game command switches the pointer and timer together,
    permits only an unresolved question to reopen, and clears it on game end. The
    pointer does not authorize access or prove that the root game is active.
  '''
}

Table game_question_states {
  game_id uuid [not null]
  board_position smallint [not null]
  question_position smallint [not null]
  first_opened_at timestamptz
  revealed_at timestamptz
  stage_index smallint [not null, default: 0]
  timer_state question_timer_state [not null, default: 'ready']
  remaining_ms integer [not null, default: 60000]
  timer_deadline_at timestamptz
  resume_timer_on_reopen boolean [not null, default: false]
  memory_first_shown_at timestamptz
  memory_first_hidden_at timestamptz
  memory_image_visible boolean [not null, default: false]

  indexes {
    (game_id, board_position, question_position) [pk, name: 'game_question_states_identity']
  }

  checks {
    `stage_index >= 0` [name: 'game_question_states_nonnegative_stage']
    `remaining_ms BETWEEN 0 AND 60000` [name: 'game_question_states_timer_bounds']
    `(timer_state = 'running') = (timer_deadline_at IS NOT NULL)` [name: 'game_question_states_timer_deadline_pair']
    `timer_state <> 'ready' OR remaining_ms = 60000` [name: 'game_question_states_ready_duration']
    `(timer_state = 'elapsed') = (remaining_ms = 0)` [name: 'game_question_states_elapsed_zero']
    `timer_state <> 'running' OR (first_opened_at IS NOT NULL AND revealed_at IS NULL)` [name: 'game_question_states_running_eligible']
    `NOT resume_timer_on_reopen OR (timer_state = 'paused' AND revealed_at IS NULL)` [name: 'game_question_states_reopen_pause']
    `revealed_at IS NULL OR (first_opened_at IS NOT NULL AND revealed_at >= first_opened_at)` [name: 'game_question_states_reveal_order']
    `memory_first_shown_at IS NULL OR (first_opened_at IS NOT NULL AND memory_first_shown_at >= first_opened_at)` [name: 'game_question_states_memory_show_order']
    `memory_first_hidden_at IS NULL OR (memory_first_shown_at IS NOT NULL AND memory_first_hidden_at >= memory_first_shown_at)` [name: 'game_question_states_memory_hide_order']
    `NOT memory_image_visible OR memory_first_shown_at IS NOT NULL` [name: 'game_question_states_memory_visibility']
    `first_opened_at IS NOT NULL OR (revealed_at IS NULL AND stage_index = 0 AND timer_state = 'ready' AND NOT resume_timer_on_reopen AND memory_first_shown_at IS NULL AND memory_first_hidden_at IS NULL AND NOT memory_image_visible)` [name: 'game_question_states_unopened_defaults']
  }

  Note: '''
    One mutable runtime row per copied question; create all 36 with accepted start.
    Private snapshot content stays in game_question_slots. Stage bounds/point defaults
    and whether memory fields apply are validated against that slot's typed snapshot.
    first_opened_at/revealed_at and first memory milestones are sticky once set.
    First opening also records exposure and the root game's immutable first-opening
    marker. Ordinary opening starts 60 seconds; memory starts on first hide only.
    Revisiting an image never restarts time; explicit host pause/reset remain available.
    For running state, remaining_ms is the checkpoint at the latest start/resume,
    not a live countdown. Read remaining as max(0, deadline - current server time).
    A past deadline may remain structurally running until the next command normalizes
    it to elapsed. No tick/heartbeat writes or per-second timer index are needed.
    Return-to-board checkpoints and pauses; the reopen flag distinguishes a timer
    paused by navigation from one deliberately paused by the host. The former resumes
    on reopening; a deliberate pause remains paused. Reset is an explicit new 60-second
    checkpoint and must not clear hints, reveal, memory history or exposure.
    Only the current unresolved question may run. Game locking/write paths enforce
    this cross-row rule and stop timing at reveal/resolution/end. Reaching zero does
    not automatically reveal, award or resolve; the host still decides. Audio replay
    is unlimited, not a counter limit;
    playback/device coordination belongs to the later media/control design.
  '''
}

Table game_question_resolutions {
  game_id uuid [not null]
  board_position smallint [not null]
  question_position smallint [not null]
  winning_team_number smallint
  awarded_points smallint [not null]
  resolved_by_account_id uuid [not null]
  command_id uuid [not null]
  resolved_at timestamptz [not null]

  indexes {
    (game_id, board_position, question_position) [pk, name: 'game_question_resolutions_identity']
    (game_id, command_id) [unique, name: 'game_question_resolutions_command']
  }

  checks {
    `awarded_points BETWEEN 0 AND 600` [name: 'game_question_resolutions_point_bounds']
    `winning_team_number IS NOT NULL OR awarded_points = 0` [name: 'game_question_resolutions_no_winner_zero']
  }

  Note: '''
    Once-only adjudication of one game question: a team with zero through original
    tile points, or nobody with zero. The transaction checks the exact 200/400/600
    snapshot cap, current stage default, opening/reveal prerequisites and current
    host credential/generation; the 0..600 row check is only a broad bound. Actor FK
    binds the original host account, not a historical device authorization. The PK
    prevents a second adjudication. Manual total adjustments never overwrite this
    row or its category attribution. End/expiry locks scores; no post-end correction.
    A winning team receives exactly one matching score entry, even for zero points;
    no-winner resolution receives no team entry. Both still count toward six-in-game
    pack completion. Resolution, score projection, eligible account completions,
    game version and any terminal transition commit atomically. The 36th resolution
    automatically finishes the game and releases claims without a review phase.
    Durable generic
    command receipts bind request digests/results; controlled write paths must still
    implement payload-conflict handling and state/version checks.
  '''
}

Table game_score_entries {
  id uuid [pk]
  game_id uuid [not null]
  team_number smallint [not null]
  entry_kind score_entry_kind [not null]
  delta bigint [not null]
  total_before bigint [not null]
  total_after bigint [not null]
  actor_account_id uuid [not null]
  command_id uuid [not null]
  state_version bigint [not null]
  source_board_position smallint
  source_question_position smallint
  recorded_at timestamptz [not null]

  indexes {
    (game_id, command_id) [unique, name: 'game_score_entries_command']
    (game_id, state_version) [unique, name: 'game_score_entries_game_order']
    (game_id, source_board_position, source_question_position) [unique, name: 'game_score_entries_question_award']
  }

  checks {
    `total_before >= 0 AND total_after >= 0` [name: 'game_score_entries_nonnegative_totals']
    `delta = total_after - total_before` [name: 'game_score_entries_exact_difference']
    `state_version > 0` [name: 'game_score_entries_positive_version']
    `(source_board_position IS NULL) = (source_question_position IS NULL)` [name: 'game_score_entries_source_pair']
    `(entry_kind = 'question_award') = (source_board_position IS NOT NULL)` [name: 'game_score_entries_source_kind']
    `entry_kind <> 'question_award' OR delta BETWEEN 0 AND 600` [name: 'game_score_entries_award_bounds']
    `entry_kind <> 'manual_adjustment' OR delta <> 0` [name: 'game_score_entries_nontrivial_adjustment']
  }

  Note: '''
    Append-only team-point history, separate from financial token movements. For an
    award, match the source resolution's team, points and command inside the same
    transaction. The source FK proves resolution identity, not those value equalities.
    For manual adjustment, accept the host's nonnegative target and record target
    minus the locked current score; unchanged targets are no-ops, not extra entries.
    One command currently changes at most one team's score. Unique game/version also
    serves ordered per-game history; source uniqueness permits multiple NULL manual
    entries but only one score entry for each resolved question. Keep prior awards.
    current_score equals the sum of committed deltas and is updated with the entry.
    These cross-row conservation, actor authority and append-only guarantees require
    controlled write paths/final DDL. Accept corrections only while the game is active,
    before the 36th resolution or an earlier end. Category winners derive from original
    question awards; manual adjustments change only the overall competition score.
    Client operation identity is game-scoped; generic command receipts must bind
    payloads/results across command types before the runtime is implementation-ready.
  '''
}

Table accounts {
  id uuid [pk]
  state account_state [not null, default: 'active']
  display_name text
  phone_e164 text [unique]
  phone_verified_at timestamptz
  preferred_locale player_locale [not null, default: 'ar']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  checks {
    `(phone_e164 IS NULL) = (phone_verified_at IS NULL)` [name: 'accounts_verified_phone_pair']
    `phone_e164 IS NULL OR (phone_e164 ~ '^\+[1-9][0-9]{7,14}$' AND left(phone_e164, 3) = '+20')` [name: 'accounts_egypt_e164_shape']
    `state = 'deleted' OR (display_name IS NOT NULL AND length(btrim(display_name)) > 0 AND phone_e164 IS NOT NULL)` [name: 'accounts_live_profile_required']
    `(state = 'deleted') = (deleted_at IS NOT NULL)` [name: 'accounts_deleted_time_pair']
    `state <> 'deleted' OR (display_name IS NULL AND phone_e164 IS NULL AND phone_verified_at IS NULL)` [name: 'accounts_deleted_profile_cleared']
    `deleted_at IS NULL OR deleted_at >= created_at` [name: 'accounts_deletion_order']
  }

  Note: '''
    Stable local player identity, separate from anonymous room membership and staff.
    Launch profile: display name, verified Egypt WhatsApp number and ar/franco locale;
    no required player email/DOB/gender/avatar. Database checks canonical shape/+20,
    while phone-number metadata and successful OTP prove country validity/ownership.
    Unique nonnull phone prevents two current accounts sharing a number; deletion
    clears personal phone/name but retains an ID tombstone for retained references.
    Changing phones verifies old/new numbers and preserves bank/history/bound gifts;
    never merge accounts or retarget old gift ownership. Authenticate Firebase ID token
    then check this local state; a deleted/disabled local account cannot regain access
    merely because external token revocation is delayed. Deletion orchestration,
    confirmed bank forfeiture and personal-data cleanup use deletion requests,
    the typed ledger source and outbox work; pending funding/retention rules remain.
  '''
}

Table firebase_identities {
  firebase_project_id text [not null]
  firebase_uid text [not null]
  account_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (firebase_project_id, firebase_uid) [pk, name: 'firebase_identities_external_identity']
    (account_id, firebase_project_id) [unique, name: 'firebase_identities_account_project']
  }

  checks {
    `length(btrim(firebase_project_id)) > 0 AND length(btrim(firebase_uid)) > 0` [name: 'firebase_identities_nonblank_identity']
  }

  Note: '''
    One stable Firebase identity per local account/project. A stable local UUID can
    supply the UID; never generate another UID for a device or phone change. NestJS
    verifies Meta-delivered OTP, issues a Firebase custom token, then verifies client
    Firebase ID tokens on authenticated API calls. Firebase owns ordinary refresh/ID
    token lifecycle; do not mirror all its sessions in PostgreSQL. Game controller
    and anonymous room credentials remain separate authorization mechanisms.
    Deletion/revocation work is coordinated with local state and external cleanup;
    retained financial references always use accounts.id, not mutable phone/UID.
  '''
}

Table phone_verification_challenges {
  id uuid [pk]
  account_id uuid
  phone_e164 text [not null]
  purpose phone_verification_purpose [not null]
  otp_mac bytea [not null]
  mac_key_version smallint [not null]
  attempts smallint [not null, default: 0]
  max_attempts smallint [not null, default: 5]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  provider_message_id text
  sent_at timestamptz
  verified_at timestamptz
  consumed_at timestamptz
  invalidated_at timestamptz

  indexes {
    (phone_e164, created_at, id) [name: 'phone_verification_challenges_phone_history']
    (expires_at, id) [name: 'phone_verification_challenges_cleanup']
  }

  checks {
    `phone_e164 ~ '^\+[1-9][0-9]{7,14}$' AND left(phone_e164, 3) = '+20'` [name: 'phone_verification_challenges_egypt_shape']
    `purpose = 'sign_in' OR account_id IS NOT NULL` [name: 'phone_verification_challenges_change_owner']
    `octet_length(otp_mac) = 32 AND mac_key_version > 0` [name: 'phone_verification_challenges_mac_shape']
    `max_attempts > 0 AND attempts BETWEEN 0 AND max_attempts` [name: 'phone_verification_challenges_attempt_bounds']
    `expires_at > created_at` [name: 'phone_verification_challenges_expiry_order']
    `sent_at IS NULL OR sent_at >= created_at` [name: 'phone_verification_challenges_send_order']
    `verified_at IS NULL OR (verified_at >= created_at AND verified_at < expires_at)` [name: 'phone_verification_challenges_verification_window']
    `consumed_at IS NULL OR (verified_at IS NOT NULL AND consumed_at >= verified_at)` [name: 'phone_verification_challenges_consumption_order']
    `invalidated_at IS NULL OR invalidated_at >= created_at` [name: 'phone_verification_challenges_invalidation_order']
  }

  Note: '''
    Short-lived Meta/WhatsApp verification proof; never store plaintext OTP. otp_mac
    is a keyed MAC using a separately managed server secret/version, not an unsalted
    hash of a guessable code. Lock verification rows for attempt/expiry/consumption
    checks and rate-limit sends by canonical phone plus service-level controls. The
    expiry is stored per issued challenge; five attempts is a proposed technical
    default, not an additional product entitlement. Phone-change proofs are purpose-
    and account-bound. Consume a proof once with its authorized identity transition.
    Provider message delivery is not proof of phone ownership or login success.
    Expired/consumed challenge retention and send-retry handling still need policy.
  '''
}

Table account_phone_changes {
  id uuid [pk]
  account_id uuid [not null]
  old_phone_e164 text [not null]
  new_phone_e164 text [not null]
  old_phone_challenge_id uuid [unique]
  new_phone_challenge_id uuid [not null, unique]
  support_audit_event_id uuid [unique]
  changed_at timestamptz [not null]

  indexes {
    (account_id, changed_at, id) [name: 'account_phone_changes_account_history']
  }

  checks {
    `old_phone_e164 <> new_phone_e164` [name: 'account_phone_changes_different_numbers']
    `old_phone_challenge_id <> new_phone_challenge_id` [name: 'account_phone_changes_distinct_proofs']
    `(old_phone_challenge_id IS NOT NULL) <> (support_audit_event_id IS NOT NULL)` [name: 'account_phone_changes_authorization_source']
  }

  Note: '''
    Successful self-service change with two independently verified one-use proofs.
    Under account/phone locks validate purpose, same account, exact old/new phones,
    fresh proof validity and unused target ownership; consume proofs, change current
    phone, record this evidence and schedule external session revocation atomically
    where local state permits. No change to account ID, bank, progress or bound gifts.
    Recovery without the old phone instead requires Super Admin support authorization
    with reason/evidence and the target account's new-phone verification; its audit
    replaces the old-phone proof, never the new-phone proof. Verify audit action/actor/
    target and ownership evidence; no automatic reassignment or account merging.
    This personal history/challenge linkage follows the
    forthcoming privacy retention policy, not indefinite financial retention.
  '''
}

Table game_players {
  game_id uuid [not null]
  room_id uuid [not null]
  room_member_id uuid [not null]
  seat_number smallint [not null]
  account_id uuid
  team_number smallint
  display_name text [not null]
  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz

  indexes {
    (game_id, seat_number) [pk, name: 'game_players_seat']
    (game_id, account_id) [unique, name: 'game_players_account']
    (game_id, room_member_id) [unique, name: 'game_players_room_member']
    (account_id, game_id) [name: 'game_players_account_history']
  }

  checks {
    `seat_number BETWEEN 1 AND 6` [name: 'game_players_seat_bounds']
    `left_at IS NULL OR left_at >= joined_at` [name: 'game_players_departure_order']
  }

  Note: '''
    Starting roster, fixed at game start, with at most six people including the host.
    Null account IDs permit anonymous people; ordinary PostgreSQL unique semantics
    allow multiple nulls while preventing a signed-in account occupying two seats.
    Identity/account binding freezes at start. Signing in later does not attach an
    account retroactively; account progress starts next game. Disconnects preserve
    participation/credit; explicit guest departure sets left_at, releases their claim
    and stops future exposure/credit without deleting the historical seat. A seat is
    not an authorization credential. Host identity is in game_host_control. Guests
    must choose one of this game's teams before start; only the host may be neutral
    with a null team. The nullable team FK permits that shape, while start validation
    checks that only the host is neutral. Team assignments freeze at start; account
    exposure/completion also includes an eligible neutral host. Reconnect uses the
    retained room credential or authenticated account mapping. Host departure ends the game
    for all players rather than using the guest-only leave transition.
    Cross-row roster freeze/host-count rules require transaction/write-path enforcement.
    room_id is deliberate composite-FK data: the selected room membership and game
    must belong to the same room. Names/team/account bindings are copied at start,
    not permanently tied to mutable lobby preferences. A member occupies at most one
    historical seat per game. Lobby readiness is rechecked for the current generation.
  '''
}

Table active_account_games {
  account_id uuid [pk]
  game_id uuid [not null]
  claimed_at timestamptz [not null, default: `now()`]

  indexes {
    (game_id, account_id) [name: 'active_account_games_release_by_game']
  }

  Note: '''
    One durable active-game claim per signed-in account. The composite FK requires
    membership in that game. Acquire all account claims and create the paid game in
    one transaction; conflicting claims reject the start without charging a token.
    Reconnect reuses the existing claim. Release together with the accepted lifecycle
    transition. Explicit guest withdrawal releases the claim with left_at in the same
    transaction. Host end/leave, full completion and effective idle expiry release all
    remaining claims. Network disconnection alone never releases a claim. An expired
    old game is finalized in its own transaction before retrying a new start, avoiding
    nested old-game locking while holding the new start's account/wallet locks.
  '''
}

Table account_question_exposures {
  account_id uuid [not null]
  question_id uuid [not null]
  first_exposed_at timestamptz [not null, default: `now()`]
  first_game_id uuid

  indexes {
    (account_id, question_id) [pk, name: 'account_question_exposures_identity']
  }

  Note: '''
    First exposure of a logical question to an account. On question opening, insert
    for the game's signed-in starting roster whose left_at is null, including temporary disconnects;
    duplicate commands do not create additional summary rows. Edits retain identity,
    while replacements use a new question ID. If first_game_id is present, its FK
    proves that account belonged to the game; nullable provenance permits a later
    explicit retention policy without discarding seen history. Detailed per-game
    events and retention remain separate work. Signing in mid-game never backfills
    anonymous exposure; explicit departure stops future writes for that player.
  '''
}

Table account_pack_completions {
  account_id uuid [not null]
  game_id uuid [not null]
  board_position smallint [not null]
  completed_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, game_id, board_position) [pk, name: 'account_pack_completions_identity']
  }

  Note: '''
    Historical completion of this game's copied six-question pack by an eligible
    signed-in starting player. Credit after all six are resolved, including no-winner
    results in this SAME game; temporary disconnects preserve eligibility. Explicit
    departure stops future credit while retaining prior completions. FKs establish
    membership and the game pack but cannot prove six resolutions; the resolution
    transaction validates that count and eligibility. Preserve historical
    completion and flag Updated when current pack membership changes; do not combine
    partial resolutions from different games or mark replacement questions completed.
  '''
}

Table game_host_control {
  game_id uuid [pk]
  host_account_id uuid [not null]
  controller_generation bigint [not null, default: 1]
  controller_credential_hash bytea [not null]
  acquired_at timestamptz [not null, default: `now()`]

  indexes {
    (game_id, host_account_id) [unique, name: 'game_host_control_host_identity']
  }

  checks {
    `controller_generation > 0` [name: 'game_host_control_positive_generation']
    `octet_length(controller_credential_hash) = 32` [name: 'game_host_control_hash_size']
  }

  Note: '''
    One signed-in host/current controller per game. The host is a signed-in roster
    member. Explicit takeover by the same host rotates an opaque credential and advances
    the generation, disabling the previous controlling device without a new token.
    Retain only a credential hash; verify authenticated host identity and the current
    credential/generation on every mutation under the game lock. Generation/device IDs
    are not credentials. Temporary disconnect keeps ownership. Transfer to another
    player is not a launch feature. Detailed session issuance, reconnect credentials
    and audit records remain authentication work. The composite unique key supports
    the ledger FK that requires the game's host to fund its token debit/restoration.
  '''
}

Table token_wallets {
  account_id uuid [pk]
  balance integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `balance >= 0` [name: 'token_wallets_nonnegative_balance']
  }

  Note: '''
    ONE visible token bank per account, including paid, gift, promotional and staff
    tokens; all are nonexpiring. There is no customer cash-out/refund feature, no
    refund reservation, no per-source spend priority and no source-based sub-wallet.
    balance is the single ledger total available for games. Retain funding/order
    evidence for history and exceptional payment reconciliation. Maintain with signed
    ledger amounts, not an independently editable staff field. A row CHECK cannot
    prove equality with the cross-row ledger sum; write paths must maintain/reconcile
    it. Source-backed settlements/grants, external reversal evidence and persistent
    staff sessions are modeled; permission/verification truth requires controlled paths.
  '''
}

Table token_ledger_entries {
  id uuid [pk]
  account_id uuid [not null]
  entry_kind token_entry_kind [not null]
  amount integer [not null]
  idempotency_key varchar(160) [not null, unique]
  credit_grant_id uuid [unique]
  deletion_request_id uuid [unique]
  staff_audit_event_id uuid [unique]
  game_id uuid
  source_debit_id uuid
  source_debit_kind token_entry_kind
  restoration_reason game_restoration_reason
  reason_text text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (game_id, entry_kind) [unique, name: 'token_ledger_entries_game_effect']
    (account_id, game_id, id, entry_kind) [unique, name: 'token_ledger_entries_typed_source']
    (account_id, created_at, id) [name: 'token_ledger_entries_account_history']
  }

  checks {
    `(entry_kind = 'credit' AND amount > 0 AND credit_grant_id IS NOT NULL AND staff_audit_event_id IS NULL AND game_id IS NULL AND source_debit_id IS NULL AND source_debit_kind IS NULL AND restoration_reason IS NULL) OR (entry_kind = 'game_debit' AND amount = -1 AND credit_grant_id IS NULL AND staff_audit_event_id IS NULL AND game_id IS NOT NULL AND source_debit_id IS NULL AND source_debit_kind IS NULL AND restoration_reason IS NULL) OR (entry_kind = 'game_restoration' AND amount = 1 AND credit_grant_id IS NULL AND game_id IS NOT NULL AND source_debit_id IS NOT NULL AND source_debit_kind IS NOT NULL AND source_debit_kind = 'game_debit' AND restoration_reason IS NOT NULL) OR (entry_kind = 'deletion_forfeiture' AND amount < 0 AND credit_grant_id IS NULL AND staff_audit_event_id IS NULL AND game_id IS NULL AND source_debit_id IS NULL AND source_debit_kind IS NULL AND restoration_reason IS NULL AND reason_text IS NOT NULL AND length(btrim(reason_text)) > 0)` [name: 'token_ledger_entries_effect_shape']
    `(entry_kind = 'deletion_forfeiture') = (deletion_request_id IS NOT NULL)` [name: 'token_ledger_entries_deletion_source']
    `restoration_reason IS DISTINCT FROM 'platform_failure' OR (staff_audit_event_id IS NOT NULL AND reason_text IS NOT NULL AND length(btrim(reason_text)) > 0)` [name: 'token_ledger_entries_failure_reason']
    `restoration_reason IS DISTINCT FROM 'unopened_game' OR staff_audit_event_id IS NULL` [name: 'token_ledger_entries_automatic_restore']
  }

  Note: '''
    Append-only signed token movements. The host pays exactly one token at accepted
    game start; guests, lobby creation, reconnect, same-game resume and host-device
    takeover are free. Game debit and restoration are each unique per game. Multiple
    funding credits have null game IDs and remain allowed by normal nullable uniqueness.
    A restoration is +1 to the same host/game as an existing -1 debit; the typed-source
    FK verifies debit kind as well as account and game. source_debit_kind is a fixed
    discriminator for this integrity check, not a caller-selected business setting.
    Unopened terminal games restore automatically. Otherwise staff may restore once
    for a verified unrecoverable platform failure, with a reason and a staff-audit
    reference. A client timeout alone is not evidence. Eligibility requires locked game
    state/first opening checks beyond these row constraints. Never replay an effect
    merely because an idempotency key collided; verify its account/source/payload.
    Every positive credit references a unique grant with matching beneficiary/quantity.
    Q75 deletion forfeiture is a once-only negative entry linked to the account's
    confirmed deletion request; its exact amount equals the locked confirmed bank.
    A zero bank needs no zero-amount ledger row. This is explicit account deletion,
    not expiry, cash-out, source allocation or an ordinary staff balance adjustment.
    Provider payment proofs/reconciliation and staff sessions are separate records.
    Financial eligibility and retained-evidence policy remain implementation/review
    responsibilities before production use; DBML does not execute those workflows.
  '''
}

Table staff_roles {
  id uuid [pk]
  code varchar(32) [not null, unique]
  name text [not null]

  Note: 'Launch codes: super_admin and content_admin. Super Admin manages staff, prices, promotions, grants and financial actions; Content Admin manages categories/questions/media and has no financial controls. Permission enforcement belongs to server actions, not merely hidden dashboard buttons. More roles are not required at launch.'
}

Table staff_accounts {
  id uuid [pk]
  role_id uuid [not null]
  normalized_email text [not null, unique]
  password_hash text [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Separate staff identity/email login from player WhatsApp/Firebase. Hash only, never plaintext passwords. Staff may separately own player accounts. Persistent staff_sessions are modeled; Super Admin manages staff and resets/deactivation revoke sessions. No self-service MFA/reset flow is added. Normalize emails and preserve referenced staff IDs/audits under the retention policy; these fields implement no authentication code.'
}

Table staff_audit_events {
  id uuid [pk]
  staff_account_id uuid [not null]
  action_code varchar(80) [not null]
  target_kind varchar(48) [not null]
  target_key varchar(160) [not null]
  request_key uuid [not null, unique]
  reason text
  details jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (staff_account_id, created_at, id) [name: 'staff_audit_events_actor_history']
    (target_kind, target_key, created_at, id) [name: 'staff_audit_events_target_history']
  }

  checks {
    `details IS NULL OR jsonb_typeof(details) = 'object'` [name: 'staff_audit_events_details_object']
    `length(btrim(action_code)) > 0 AND length(btrim(target_kind)) > 0 AND length(btrim(target_key)) > 0` [name: 'staff_audit_events_nonblank_target_action']
  }

  Note: '''
    Append-only actor/action evidence committed with a privileged effect. Target kind/key
    are generic audit metadata, not a cross-table FK; financial sources below keep
    explicit references to this event. Verify role/actor/action/target/payload in the
    write transaction; an audit FK alone proves neither permission nor correct action.
    Reuse request_key on retry and validate scope. Store sanitized relevant changes,
    not credentials/secrets or an unbounded request dump. Retention remains pending.
    target_key canonically represents UUID, singleton integer or composite resource
    keys; do not force every audited resource to have a UUID primary key. In particular,
    price/branding settings use key 1 and fixed token bundles use their quantity.
  '''
}

Table token_shop_settings {
  id smallint [pk, default: 1]
  currency char(3) [not null, default: 'EGP']
  base_unit_price_minor bigint [not null, default: 10000]
  gift_discount_bps smallint [not null, default: 1000]
  pricing_version bigint [not null, default: 1]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `id = 1` [name: 'token_shop_settings_singleton']
    `currency = 'EGP'` [name: 'token_shop_settings_currency']
    `base_unit_price_minor > 0` [name: 'token_shop_settings_positive_price']
    `gift_discount_bps BETWEEN 0 AND 10000` [name: 'token_shop_settings_gift_discount']
    `pricing_version > 0` [name: 'token_shop_settings_positive_version']
  }

  Note: '''
    Launch base price is 100 EGP = 10,000 minor units per token, editable by Super Admin.
    Existing gift default is 10 percent, also proposed as an editable setting. Preset
    buttons choose 1/2/5 quantities; custom chooses 1-20, with identical pricing for
    identical quantities. Price/tier edits use one consistent settings lock and advance
    pricing_version; existing orders retain accepted monetary snapshots. Valid 100%
    discounts may create zero-cost orders; use a local accepted settlement with no
    Paymob attempt. Configured percentages stay within0-100% and totals nonnegative.
  '''
}

Table token_price_tiers {
  id uuid [pk]
  minimum_quantity smallint [not null, unique]
  discount_bps smallint [not null]
  is_active boolean [not null, default: true]

  checks {
    `minimum_quantity BETWEEN 1 AND 20` [name: 'token_price_tiers_quantity']
    `discount_bps BETWEEN 0 AND 10000` [name: 'token_price_tiers_discount']
  }

  Note: '''
    Editable quantity thresholds apply to presets and custom quantities. Use the active
    highest threshold not exceeding quantity, with no matching tier meaning zero tier
    discount. Percentages are launch configuration still to be supplied; 2+ and 5+ were
    examples, not seeded discounts. Current tier rows are editable; orders copy values.
    Percentage monotonicity and an unambiguous price quote are validated under the
    settings lock. There is no token product multiplier or separate preset price.
  '''
}

Table promotions {
  id uuid [pk]
  trigger promotion_trigger [not null, default: 'code']
  code varchar(64) [unique]
  discount_bps smallint [not null]
  eligible_bundle_quantity integer [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  maximum_redemptions integer
  per_buyer_limit integer [default: 1]
  is_active boolean [not null, default: true]

  indexes {
    (id, trigger) [unique, name: 'promotions_trigger_identity']
  }

  checks {
    `(trigger = 'code' AND code IS NOT NULL AND length(btrim(code)) > 0) OR (trigger = 'automatic_free' AND code IS NULL AND discount_bps = 10000)` [name: 'promotions_trigger_shape']
    `discount_bps BETWEEN 1 AND 10000` [name: 'promotions_discount']
    `ends_at > starts_at` [name: 'promotions_valid_window']
    `maximum_redemptions IS NULL OR maximum_redemptions > 0` [name: 'promotions_global_limit']
    `per_buyer_limit IS NULL OR per_buyer_limit > 0` [name: 'promotions_buyer_limit']
  }

  Note: '''
    AdminJS-configured validity and optional global cap; per-buyer successful-use limit
    defaults to one. Gifted-order use belongs to its buyer. Current scope uses percentage
    codes; fixed-value coupons are not required. Each code targets one fixed bundle
    and requires an end date. Validate target at quote/admission and freeze eligibility;
    later scope edits must not rewrite an accepted order. The exact target quantity
    qualifies through either selector; other quantities do not. Code normalization
    is server-controlled. Automatic free campaigns have no entered code, use 100%
    authorization, target a fixed bundle/end date and share buyer/global admission
    controls. A zero price from configured quantity/gift discounts requires an eligible
    automatic campaign unless an applied entered code already authorizes that order.
    Skip ineligible automatic-free offers when computing ordinary purchasable pricing.
    Preserve campaign trigger identity once referenced; scope/price edits do not rewrite
    accepted orders. Matching late payments may exceed a released hold's quota only
    with a recorded reconciliation exception, never by hiding the actual payment.
    100% codes settle locally; they consume their allowed use atomically. Only the
    winning effective code is applied/reserved; an unused entered code does not consume
    a redemption. Compare eligibility and actual savings after quantity pricing.
  '''
}

Table token_orders {
  id uuid [pk]
  buyer_account_id uuid [not null]
  order_kind token_order_kind [not null]
  beneficiary_account_id uuid
  token_quantity integer [not null]
  currency char(3) [not null, default: 'EGP']
  pricing_version bigint [not null]
  price_tier_id uuid
  base_unit_price_minor bigint [not null]
  quantity_discount_bps smallint [not null, default: 0]
  list_subtotal_minor bigint [not null]
  quantity_discount_minor bigint [not null]
  offer_subtotal_minor bigint [not null]
  additional_discount_kind applied_discount_kind [not null, default: 'none']
  additional_discount_bps smallint [not null, default: 0]
  applied_promotion_id uuid
  applied_promotion_trigger promotion_trigger
  additional_discount_minor bigint [not null]
  total_minor bigint [not null]
  payment_state order_payment_state [not null, default: 'pending']
  verified_paid_at timestamptz
  zero_total_accepted_at timestamptz
  idempotency_key uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_account_id, idempotency_key) [unique, name: 'token_orders_buyer_request']
    (buyer_account_id, created_at, id) [name: 'token_orders_buyer_history']
    (id, beneficiary_account_id, token_quantity) [unique, name: 'token_orders_fulfillment_identity']
    (id, buyer_account_id, applied_promotion_id) [unique, name: 'token_orders_promo_identity']
    (id, order_kind) [unique, name: 'token_orders_kind_identity']
  }

  checks {
    `token_quantity BETWEEN 1 AND 20` [name: 'token_orders_quantity_cap']
    `currency = 'EGP'` [name: 'token_orders_currency']
    `pricing_version > 0 AND base_unit_price_minor > 0` [name: 'token_orders_price_basis']
    `quantity_discount_bps BETWEEN 0 AND 10000 AND additional_discount_bps BETWEEN 0 AND 10000` [name: 'token_orders_discount_bounds']
    `list_subtotal_minor = token_quantity::numeric * base_unit_price_minor` [name: 'token_orders_list_total']
    `quantity_discount_minor = round(list_subtotal_minor::numeric * quantity_discount_bps / 10000)` [name: 'token_orders_quantity_reduction']
    `offer_subtotal_minor = list_subtotal_minor - quantity_discount_minor` [name: 'token_orders_offer_total']
    `additional_discount_minor = round(offer_subtotal_minor::numeric * additional_discount_bps / 10000)` [name: 'token_orders_extra_reduction']
    `total_minor = offer_subtotal_minor - additional_discount_minor AND total_minor >= 0` [name: 'token_orders_payable_total']
    `(order_kind = 'personal' AND beneficiary_account_id IS NOT NULL AND beneficiary_account_id = buyer_account_id) OR (order_kind = 'gift' AND (beneficiary_account_id IS NULL OR beneficiary_account_id <> buyer_account_id))` [name: 'token_orders_beneficiary_shape']
    `(additional_discount_kind = 'none' AND additional_discount_bps = 0) OR (additional_discount_kind = 'gift' AND order_kind = 'gift' AND additional_discount_bps > 0) OR (additional_discount_kind = 'promo_code' AND additional_discount_bps > 0 AND applied_promotion_id IS NOT NULL)` [name: 'token_orders_one_extra_discount']
    `(applied_promotion_id IS NULL) = (applied_promotion_trigger IS NULL)` [name: 'token_orders_promotion_trigger_pair']
    `(applied_promotion_trigger IS NULL AND additional_discount_kind <> 'promo_code') OR (applied_promotion_trigger = 'code' AND additional_discount_kind = 'promo_code') OR (applied_promotion_trigger = 'automatic_free' AND additional_discount_kind <> 'promo_code' AND total_minor = 0)` [name: 'token_orders_promotion_application']
    `applied_promotion_id IS NULL OR token_quantity IN (1, 2, 5)` [name: 'token_orders_promo_fixed_bundle']
    `total_minor <> 0 OR applied_promotion_id IS NOT NULL` [name: 'token_orders_free_campaign_required']
    `(payment_state = 'paid') = (verified_paid_at IS NOT NULL)` [name: 'token_orders_payment_marker']
    `(payment_state = 'not_required') = (zero_total_accepted_at IS NOT NULL)` [name: 'token_orders_zero_marker']
    `(total_minor = 0 AND payment_state IN ('not_required', 'cancelled')) OR (total_minor > 0 AND payment_state IN ('pending', 'paid', 'cancelled'))` [name: 'token_orders_settlement_amount']
    `zero_total_accepted_at IS NULL OR zero_total_accepted_at >= created_at` [name: 'token_orders_zero_acceptance_order']
  }

  Note: '''
    One priced token purchase, personal or one gift; no multi-product/multi-recipient
    basket is in scope. Quantity shortcuts are not extra item multipliers. Freeze
    unit/list/quantity-offer amounts, then apply exactly one better eligible gift or
    promo discount. Bps use 10,000 = 100%; exact numeric arithmetic rounds positive
    discount amounts to whole currency minor units. Rounding convention is a proposed
    technical choice. Amounts/currency are server-authoritative. Later catalog/promo
    edits do not reprice the order. At zero, validate the actual configured discount,
    recipient and promo allowance, accept locally, consume use and grant once with no
    Paymob checkout/transaction. A free gift still waits for recipient claim if unbound.
    Never fabricate a paid flag/transaction. Positive payment state/time is only
    an internal projection, not proof of a verified merchant payment. Attempts, actual
    transactions, authenticated receipts and one settlement source are modeled below.
    Automatic free campaign identity authorizes configured zero prices without changing
    the frozen arithmetic or consuming a redundant entered code. Both trigger classes
    use the same once-only buyer/global allowance; table checks do not prove eligibility.
    Personal beneficiary is buyer. For a gift, bind an existing verified recipient
    account at checkout; otherwise bind once on first verified claim. Never redirect
    later by repeating a phone lookup. Binding/payment/grant are serialized. Phone
    proof is checked against the identity model. Order/beneficiary/price
    immutability after binding/checkout requires transaction and permission rules.
  '''
}

Table promo_usages {
  order_id uuid [pk]
  promotion_id uuid [not null]
  buyer_account_id uuid [not null]
  state promo_usage_state [not null, default: 'held']
  held_at timestamptz [not null, default: `now()`]
  consumed_at timestamptz
  released_at timestamptz
  release_reason text

  indexes {
    (promotion_id, state) [name: 'promo_usages_global_counts']
    (promotion_id, buyer_account_id, state) [name: 'promo_usages_buyer_counts']
  }

  checks {
    `(state = 'held' AND consumed_at IS NULL AND released_at IS NULL) OR (state = 'consumed' AND consumed_at IS NOT NULL AND released_at IS NULL) OR (state = 'released' AND consumed_at IS NULL AND released_at IS NOT NULL)` [name: 'promo_usages_state_times']
    `consumed_at IS NULL OR consumed_at >= held_at` [name: 'promo_usages_consumption_order']
    `released_at IS NULL OR (released_at >= held_at AND (consumed_at IS NULL OR released_at >= consumed_at))` [name: 'promo_usages_release_order']
    `state <> 'released' OR (release_reason IS NOT NULL AND length(btrim(release_reason)) > 0)` [name: 'promo_usages_release_reason']
  }

  Note: '''
    Usage belongs to the buyer and actual applied code/automatic free campaign,
    enforced by the order FK.
    Reserve allowance at checkout, consume on verified payment OR valid zero-cost
    acceptance, and release only after confirming the payment path closed unpaid.
    Unknown outcomes stay held for reconciliation; browser closure/local timeout is
    insufficient evidence. A zero-cost order can hold and consume in one transaction.
    No provider attempt is made for it. A consumed use is never released because of
    an unused game or token restoration. Preserve its consumption marker; transition
    guards are required in addition to row shape. Late verified settlement can consume
    a previously released use only with its prior release evidence recorded in a
    reconciliation case. Admission locks the promotion and counts held plus consumed
    capacity; row CHECK cannot count other rows.
  '''
}

Table gifts {
  order_id uuid [pk]
  order_kind token_order_kind [not null, default: 'gift']
  recipient_phone_e164 varchar(20) [not null]
  note text
  recipient_bound_at timestamptz

  indexes {
    (recipient_phone_e164, order_id) [name: 'gifts_phone_claim_lookup']
  }

  checks {
    `order_kind = 'gift'` [name: 'gifts_gift_order_only']
    `length(btrim(recipient_phone_e164)) > 0` [name: 'gifts_recipient_present']
  }

  Note: '''
    One recipient per gift order, tied to a normalized verified-phone claim. The single
    authoritative bound account lives on token_orders.beneficiary_account_id; do not
    duplicate or re-resolve it on payment retries. Bind a currently verified account
    at checkout, else once on an authorized claim. Keep the original recipient phone
    snapshot after account changes. Block buyer's own verified phone at creation and
    own account at binding/credit. Gift row presence, verification and bound-at pairing
    require the order/claim transaction; these FKs do not prove ownership of a phone.
    Unclaimed gifts do not expire. Only audited Super Admin corrections of an unbound
    phone are allowed. Bound-account identity remains stable through phone recycling,
    buyer deletion and payment retries. Deleted beneficiaries/reversals are reconciliation,
    never a reason to substitute the buyer or silently redirect value.
  '''
}

Table token_credit_grants {
  id uuid [pk]
  beneficiary_account_id uuid [not null]
  token_quantity integer [not null]
  source_order_id uuid [unique]
  staff_audit_event_id uuid [unique]
  reason_text text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id, beneficiary_account_id, token_quantity) [unique, name: 'token_credit_grants_ledger_identity']
    (beneficiary_account_id, created_at, id) [name: 'token_credit_grants_account_history']
  }

  checks {
    `token_quantity > 0` [name: 'token_credit_grants_positive_quantity']
    `(source_order_id IS NOT NULL) <> (staff_audit_event_id IS NOT NULL)` [name: 'token_credit_grants_one_source']
    `staff_audit_event_id IS NULL OR (reason_text IS NOT NULL AND length(btrim(reason_text)) > 0)` [name: 'token_credit_grants_staff_reason']
  }

  Note: '''
    One authorized positive funding source: a verified paid or valid zero-cost order, or one
    privileged complimentary staff action. Order quantity and beneficiary must match
    the bound order via composite FK; UNIQUE source_order_id means several successful
    transactions for one order still grant once. Staff grants are nonexpiring and need
    Super Admin authority plus a reason and audit. Quantity cap20 applies to purchases,
    not an unapproved complimentary-grant limit. Create grant, ledger credit and balance
    update atomically. All sources join the same bank without expiry or spending
    allocation by source. FKs prove linkage, not payment
    verification, valid zero-cost authorization or staff permission;
    those are required locked transaction checks. Payment/reversal provenance is
    modeled separately; staff audit action/target truth remains a permission check.
  '''
}

Table gift_phone_corrections {
  id uuid [pk]
  order_id uuid [not null]
  requested_by_account_id uuid [not null]
  request_key uuid [not null, unique]
  old_phone_e164 text [not null]
  new_phone_e164 text [not null]
  staff_audit_event_id uuid [not null, unique]
  corrected_at timestamptz [not null]

  indexes {
    (order_id, corrected_at, id) [name: 'gift_phone_corrections_order_history']
  }

  checks {
    `old_phone_e164 <> new_phone_e164` [name: 'gift_phone_corrections_different_numbers']
  }

  Note: '''
    Applied Super Admin correction of an unbound/unclaimed gift only, after verifying
    the original buyer's request. Under account/order locks confirm requesting account
    is buyer, no beneficiary/grant exists, and new verified/canonical recipient is not
    self-gifting. Record old/new phone and required reason/evidence in staff audit.
    If the corrected phone already belongs to an eligible account, bind it once now;
    otherwise retain unbound claim behavior. A paid gift may then fulfill once.
    Never edit an already bound gift, reroute on retries or expire unclaimed value.
    Personal phone evidence follows the retention policy, not arbitrary permanent logs.
  '''
}

Table token_bundles {
  token_quantity integer [pk]
  display_order smallint [not null]
  is_active boolean [not null, default: true]

  checks {
    `token_quantity IN (1, 2, 5)` [name: 'token_bundles_launch_quantities']
    `display_order >= 0` [name: 'token_bundles_display_order']
  }

  Note: '''
    Fixed launch quantity selectors and promo targets:1,2,5 tokens. Pricing comes
    from the same base/tiers as the counter, not a separate price/product multiplier.
    Promo codes target exactly one of these bundles and expire. Exact-quantity custom
    counter selection also qualifies; other quantities do not. These rows retain their quantity
    identity; deactivate instead of deleting a referenced target. A new bundle set would
    be an explicit change rather than silently treating an arbitrary custom quantity as
    a fixed bundle. No independent token banks are created by these selectors.
  '''
}

Table payment_merchant_accounts {
  id uuid [pk]
  provider varchar(24) [not null, default: 'paymob']
  environment payment_environment [not null]
  provider_merchant_id text [not null]
  configuration_key varchar(80) [not null, unique]
  allowed_integration_ids text[] [not null]
  is_active boolean [not null, default: true]

  indexes {
    (provider, environment, provider_merchant_id) [unique, name: 'payment_merchant_accounts_identity']
  }

  checks {
    `provider = 'paymob'` [name: 'payment_merchant_accounts_launch_provider']
    `length(btrim(provider_merchant_id)) > 0` [name: 'payment_merchant_accounts_nonblank_merchant']
    `cardinality(allowed_integration_ids) > 0 AND array_position(allowed_integration_ids, NULL) IS NULL` [name: 'payment_merchant_accounts_integrations_present']
  }

  Note: '''
    Explicit merchant/environment namespace for every provider ID. configuration_key
    resolves server-managed credentials/HMAC keys; no API key, HMAC secret, card data
    or provider bearer credential is stored here. Integration IDs are a small validated
    configuration set, frozen on each attempt; they are not independent sold products.
    Deactivate configuration instead of mutating a namespace used by financial history.
    Exact enabled APIs/methods and credential setup are merchant deployment facts.
  '''
}

Table payment_attempts {
  id uuid [pk]
  order_id uuid [not null]
  merchant_account_id uuid [not null]
  request_key uuid [not null]
  state payment_attempt_state [not null, default: 'initializing']
  special_reference varchar(160) [not null]
  allowed_integration_ids text[] [not null]
  checkout_credentials_ciphertext bytea
  encryption_key_version smallint
  created_at timestamptz [not null]
  provider_expires_at timestamptz
  confirmed_unpaid_at timestamptz
  closure_verification_event_id uuid
  last_inquired_at timestamptz

  indexes {
    (order_id, request_key) [unique, name: 'payment_attempts_order_request']
    (id, order_id, merchant_account_id) [unique, name: 'payment_attempts_financial_identity']
    (merchant_account_id, special_reference) [unique, name: 'payment_attempts_correlation_reference']
    (order_id, created_at, id) [name: 'payment_attempts_order_history']
  }

  checks {
    `length(btrim(special_reference)) > 0` [name: 'payment_attempts_nonblank_reference']
    `cardinality(allowed_integration_ids) > 0 AND array_position(allowed_integration_ids, NULL) IS NULL` [name: 'payment_attempts_integrations_present']
    `(checkout_credentials_ciphertext IS NULL) = (encryption_key_version IS NULL)` [name: 'payment_attempts_encryption_pair']
    `encryption_key_version IS NULL OR encryption_key_version > 0` [name: 'payment_attempts_encryption_version']
    `(state = 'closed_unpaid') = (confirmed_unpaid_at IS NOT NULL)` [name: 'payment_attempts_unpaid_confirmation']
    `(confirmed_unpaid_at IS NULL) = (closure_verification_event_id IS NULL)` [name: 'payment_attempts_closure_proof_pair']
    `confirmed_unpaid_at IS NULL OR confirmed_unpaid_at >= created_at` [name: 'payment_attempts_confirmation_order']
    `provider_expires_at IS NULL OR provider_expires_at > created_at` [name: 'payment_attempts_expiry_order']
  }

  Note: '''
    One local hosted-checkout creation attempt for a positive-price frozen order.
    Zero-cost orders never create this record. special_reference is correlation,
    not proof of provider-native idempotency. Timeout after creation is unknown:
    persist/reconcile before another external creation rather than blindly repeating.
    If resumable checkout secrets must be retained, encrypt them with an external key;
    do not put client secrets or secret-bearing URLs in ordinary JSON/logs/audit.
    Intention expiry/local browser timeout alone does not prove money cannot arrive.
    closed_unpaid requires authoritative closure evidence; late verified settlement
    can still move to paid with an exception record, clearing the projection marker.
    Provider HTTP calls occur outside short database locks. Durable work coordinates
    retries/inquiry; exact merchant method contracts remain adapter validation work.
  '''
}

Table payment_provider_references {
  merchant_account_id uuid [not null]
  reference_kind provider_reference_kind [not null]
  provider_reference text [not null]
  attempt_id uuid [not null]
  order_id uuid [not null]

  indexes {
    (merchant_account_id, reference_kind, provider_reference) [pk, name: 'payment_provider_references_identity']
    (attempt_id, reference_kind) [name: 'payment_provider_references_attempt_lookup']
  }

  checks {
    `length(btrim(provider_reference)) > 0` [name: 'payment_provider_references_nonblank']
  }

  Note: '''
    Actual intention/order identifiers returned by the enabled provider API. Several
    typed references may identify one attempt; no undocumented 1:1 provider object
    model is assumed. A merchant/type/reference maps to one local attempt/order only.
    Composite FK binds it to the attempt's exact local order and merchant namespace.
    Resolve callbacks through stored references; never match by customer phone alone.
  '''
}

Table payment_transactions {
  id uuid [pk]
  merchant_account_id uuid [not null]
  provider_transaction_id text [not null]
  transaction_kind payment_transaction_kind [not null, default: 'payment']
  parent_transaction_id uuid
  attempt_id uuid [not null]
  order_id uuid [not null]
  integration_id text [not null]
  amount_minor bigint [not null]
  currency char(3) [not null]
  outcome payment_outcome [not null, default: 'pending']
  captured_minor bigint [not null, default: 0]
  refunded_minor bigint [not null, default: 0]
  last_verification_event_id uuid
  last_verified_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (merchant_account_id, provider_transaction_id) [unique, name: 'payment_transactions_provider_identity']
    (id, order_id, transaction_kind) [unique, name: 'payment_transactions_order_identity']
    (order_id, created_at, id) [name: 'payment_transactions_order_history']
  }

  checks {
    `length(btrim(provider_transaction_id)) > 0 AND length(btrim(integration_id)) > 0` [name: 'payment_transactions_nonblank_references']
    `amount_minor > 0 AND captured_minor BETWEEN 0 AND amount_minor AND refunded_minor BETWEEN 0 AND captured_minor` [name: 'payment_transactions_amount_bounds']
    `(last_verification_event_id IS NULL) = (last_verified_at IS NULL)` [name: 'payment_transactions_verification_pair']
    `last_verified_at IS NULL OR last_verified_at >= created_at` [name: 'payment_transactions_verification_order']
    `transaction_kind = 'payment' OR parent_transaction_id IS NOT NULL` [name: 'payment_transactions_action_parent']
    `parent_transaction_id IS NULL OR parent_transaction_id <> id` [name: 'payment_transactions_no_self_parent']
  }

  Note: '''
    One actual payment transaction in its merchant/environment namespace. Distinct
    successful provider transactions are distinct facts, even for one local order.
    The attempt FK binds exact order/merchant. Currency deliberately need not be EGP:
    retain mismatched real payments for reconciliation rather than rejecting evidence.
    Positive fulfillment requires verified correct integration, exact order amount/EGP
    and successful sale/capture, not pending authorization or browser success.
    captured/refunded are confirmed cumulative financial facts; unsigned reversal
    details require authenticated inquiry. Do not infer callback ordering/finality.
    Later reversal never deletes the original settlement/grant or automatically
    makes the permanent token bank negative. Record a staff reconciliation case.
    Actual separately identified capture/refund/void transactions reference their
    original mapped transaction; validate same merchant/order and acyclic ancestry.
    An update to the original transaction's refund total remains a new verified
    observation of that original ID. Reversal transactions cannot fund a settlement.
    Unmapped verified notifications remain in the durable receipt inbox until matched.
  '''
}

Table payment_receipts {
  id uuid [pk]
  merchant_account_id uuid [not null]
  fingerprint bytea [not null]
  notification_type varchar(40) [not null]
  provider_transaction_id text
  provider_order_reference text
  normalized_facts jsonb [not null]
  received_at timestamptz [not null]
  hmac_verified_at timestamptz [not null]
  state payment_receipt_state [not null, default: 'queued']
  processed_transaction_id uuid
  processed_at timestamptz
  last_error_code varchar(80)

  indexes {
    (merchant_account_id, fingerprint) [unique, name: 'payment_receipts_exact_delivery']
    (state, received_at, id) [name: 'payment_receipts_pending_work']
  }

  checks {
    `octet_length(fingerprint) = 32` [name: 'payment_receipts_fingerprint_shape']
    `jsonb_typeof(normalized_facts) = 'object'` [name: 'payment_receipts_facts_object']
    `hmac_verified_at >= received_at` [name: 'payment_receipts_verification_order']
    `(state IN ('processed', 'ignored')) = (processed_at IS NOT NULL)` [name: 'payment_receipts_processing_pair']
    `processed_at IS NULL OR processed_at >= hmac_verified_at` [name: 'payment_receipts_processing_order']
    `state <> 'processed' OR processed_transaction_id IS NOT NULL` [name: 'payment_receipts_processed_mapping']
  }

  Note: '''
    Durable verified transaction-notification intake before acknowledging acceptance.
    Verify the documented event-specific HMAC first. Persist sanitized financial facts
    and a digest, not raw card/token/contact payloads or authentication secrets.
    Fingerprint deduplicates exact deliveries only; it is not an invented Paymob event
    ID. Do not put UNIQUE on provider_transaction_id: later changed notifications for
    the same transaction must remain processable. Card-token notifications are a
    separate contract and never authorize game-token credit. Unknown mappings/conflicts
    remain needs_review with evidence; authenticated inquiry resolves unsigned fields.
    Raw provider retry schedules/order/native idempotency are not assumed.
  '''
}

Table payment_verification_events {
  id uuid [pk]
  attempt_id uuid [not null]
  transaction_id uuid
  verification_method payment_verification_method [not null]
  receipt_id uuid [unique]
  facts_hash bytea [not null]
  verified_facts jsonb [not null]
  confirms_closed_unpaid boolean [not null, default: false]
  verified_at timestamptz [not null]

  indexes {
    (id, transaction_id) [unique, name: 'payment_verification_events_transaction_identity']
    (id, attempt_id) [unique, name: 'payment_verification_events_attempt_identity']
    (attempt_id, facts_hash) [unique, name: 'payment_verification_events_distinct_facts']
  }

  checks {
    `(verification_method = 'hmac_callback') = (receipt_id IS NOT NULL)` [name: 'payment_verification_events_receipt_pair']
    `octet_length(facts_hash) = 32 AND jsonb_typeof(verified_facts) = 'object'` [name: 'payment_verification_events_facts_shape']
    `verification_method <> 'hmac_callback' OR transaction_id IS NOT NULL` [name: 'payment_verification_events_callback_mapping']
    `NOT confirms_closed_unpaid OR (verification_method = 'authenticated_inquiry' AND transaction_id IS NULL)` [name: 'payment_verification_events_closure_shape']
  }

  Note: '''
    Append-only normalized proof of a distinct verified attempt/financial state, from
    a mapped HMAC callback or authenticated provider inquiry. Hash includes proof kind
    and canonical financial facts plus transaction identity, excluding inquiry times.
    An authenticated no-transaction closure inquiry can prove attempt closure, while
    successful funding requires a proof explicitly bound to its payment transaction.
    confirms_closed_unpaid requires an actually supported final-unpaid contract, not
    local timeout or expiry alone. Validate proof transaction/attempt and receipt
    merchant agreement in the processing transaction. Identical inquiry
    results need not create endless rows; update the transaction's last verified time.
    Validate receipt merchant/transaction mapping and which fields HMAC actually covers;
    a receipt FK alone does not prove all JSON fields are signed. Successful funding
    references this exact transaction proof. No provider API response is assumed final
    merely because HTTP returned 200. Store no payment credentials/card secrets.
  '''
}

Table token_order_settlements {
  order_id uuid [pk]
  settlement_kind settlement_kind [not null]
  payment_transaction_id uuid [unique]
  source_payment_kind payment_transaction_kind
  verification_event_id uuid
  settled_at timestamptz [not null]

  checks {
    `(settlement_kind = 'payment' AND payment_transaction_id IS NOT NULL AND source_payment_kind IS NOT NULL AND source_payment_kind IN ('payment', 'capture') AND verification_event_id IS NOT NULL) OR (settlement_kind = 'zero_cost' AND payment_transaction_id IS NULL AND source_payment_kind IS NULL AND verification_event_id IS NULL)` [name: 'token_order_settlements_source_shape']
  }

  Note: '''
    One accepted funding source per local order: exact verified positive payment or
    valid local zero-cost acceptance, never both. Composite references bind payment
    and proof to this order/transaction. Runtime verifies source financial facts,
    frozen pricing, discount eligibility and beneficiary status before fulfillment.
    Several real payments still produce one settlement/grant; extras are reconciliation.
    A paid unbound gift can settle before account claim; its grant waits for binding.
    Local paid/zero markers, promotion usage, settlement and any available grant/bank
    update commit together. Reversals retain the original funding evidence.
  '''
}

Table payment_reconciliation_cases {
  id uuid [pk]
  case_key varchar(160) [not null, unique]
  case_type varchar(48) [not null]
  state reconciliation_state [not null, default: 'open']
  order_id uuid
  attempt_id uuid
  transaction_id uuid
  receipt_id uuid
  details jsonb [not null, default: `'{}'::jsonb`]
  opened_at timestamptz [not null]
  resolved_at timestamptz
  resolution_audit_event_id uuid

  indexes {
    (state, opened_at, id) [name: 'payment_reconciliation_cases_staff_queue']
    (order_id, opened_at, id) [name: 'payment_reconciliation_cases_order_history']
  }

  checks {
    `length(btrim(case_type)) > 0 AND jsonb_typeof(details) = 'object'` [name: 'payment_reconciliation_cases_details_shape']
    `order_id IS NOT NULL OR attempt_id IS NOT NULL OR transaction_id IS NOT NULL OR receipt_id IS NOT NULL` [name: 'payment_reconciliation_cases_evidence_present']
    `(state = 'resolved') = (resolved_at IS NOT NULL)` [name: 'payment_reconciliation_cases_resolution_time']
    `(resolved_at IS NULL) = (resolution_audit_event_id IS NULL)` [name: 'payment_reconciliation_cases_resolution_actor']
    `resolved_at IS NULL OR resolved_at >= opened_at` [name: 'payment_reconciliation_cases_time_order']
  }

  Note: '''
    Super Admin exceptions: extra distinct payments, late closed-order settlement,
    released-promo quota exception, mismatched amount/currency, deleted beneficiary,
    actual provider reversal, unknown create outcome or unmapped verified notification.
    case_key prevents duplicate issue creation. Validate provided evidence links belong
    together; each optional FK proves existence, not agreement among all supplied IDs.
    Matching late payment fulfills the original order once, with any case recorded;
    wrong/deleted-recipient cases require review rather than automatic rerouting.
    Resolution requires role, reason and audit of the actual action/evidence. This is
    not a customer cash-out/refund API, source-lot allocation or negative-wallet policy.
  '''
}

Table account_deletion_requests {
  id uuid [pk]
  account_id uuid [not null]
  request_key uuid [not null, unique]
  state deletion_request_state [not null, default: 'requested']
  confirmed_bank integer
  requested_at timestamptz [not null]
  funding_cleared_at timestamptz
  confirmed_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz

  indexes {
    (id, account_id) [unique, name: 'account_deletion_requests_account_identity']
    (account_id, requested_at, id) [name: 'account_deletion_requests_account_history']
    (state, requested_at, id) [name: 'account_deletion_requests_pending_work']
  }

  checks {
    `(confirmed_bank IS NULL) = (confirmed_at IS NULL)` [name: 'account_deletion_requests_confirmation_pair']
    `confirmed_bank IS NULL OR confirmed_bank >= 0` [name: 'account_deletion_requests_bank_bounds']
    `state NOT IN ('confirmed', 'completed') OR confirmed_at IS NOT NULL` [name: 'account_deletion_requests_confirmation_required']
    `(state = 'completed') = (completed_at IS NOT NULL)` [name: 'account_deletion_requests_completion_pair']
    `(state = 'cancelled') = (cancelled_at IS NOT NULL)` [name: 'account_deletion_requests_cancellation_pair']
    `confirmed_at IS NULL OR confirmed_at >= requested_at` [name: 'account_deletion_requests_confirmation_order']
    `completed_at IS NULL OR (confirmed_at IS NOT NULL AND completed_at >= confirmed_at)` [name: 'account_deletion_requests_completion_order']
    `cancelled_at IS NULL OR cancelled_at >= requested_at` [name: 'account_deletion_requests_cancellation_order']
  }

  Note: '''
    Authenticated explicit deletion request/consent, including the exact nonnegative
    bank the player agreed to forfeit. Leave/end active play first, using its normal
    game restoration rules. Serialize final deletion with funding and the wallet;
    a changed balance requires reconfirmation, not silently forfeiting extra credits.
    A positive confirmed bank gets one deletion_forfeiture ledger entry; zero needs no
    ledger row. Clear bank/profile/credentials and schedule external cleanup while
    retaining required financial IDs/evidence and valid gifts for other recipients.
    Add a partial unique open request per account in supplementary PostgreSQL DDL.
    Detailed unresolved-funding gating follows the pending Q86 answer; retention/
    anonymization work must not be confused with physical deletion of referenced IDs.
  '''
}

Table staff_sessions {
  session_hash bytea [pk]
  staff_account_id uuid [not null]
  session_data jsonb [not null, default: `'{}'::jsonb`]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz

  indexes {
    (staff_account_id, expires_at) [name: 'staff_sessions_account_revocation']
    expires_at [name: 'staff_sessions_expiry_cleanup']
  }

  checks {
    `octet_length(session_hash) = 32` [name: 'staff_sessions_hash_shape']
    `jsonb_typeof(session_data) = 'object'` [name: 'staff_sessions_data_object']
    `expires_at > created_at` [name: 'staff_sessions_expiry_order']
    `revoked_at IS NULL OR revoked_at >= created_at` [name: 'staff_sessions_revocation_order']
  }

  Note: '''
    Persistent AdminJS staff-session store, replacing the starter's memory sessions.
    Proposed adapter hashes an opaque cookie token before lookup; session_data holds
    bounded nonsecret middleware state, never password hashes or raw credentials.
    Match actual session-store adapter serialization in implementation; this is not
    claimed as an unmodified third-party package's table schema. Recheck current staff
    activity/role for every protected action. Logout/deactivation/password reset revoke
    affected sessions; no player Firebase identity gains staff access. Use a fixed
    expiry or bounded renewal cadence, avoiding a database write for every admin asset.
    Self-service staff MFA/reset is not added launch scope; Super Admin manages staff.
  '''
}

Table game_host_command_receipts {
  game_id uuid [not null]
  command_id uuid [not null]
  host_account_id uuid [not null]
  command_name varchar(64) [not null]
  request_digest bytea [not null]
  controller_generation bigint [not null]
  expected_version bigint [not null]
  result_version bigint [not null]
  result_data jsonb [not null, default: `'{}'::jsonb`]
  accepted_at timestamptz [not null]

  indexes {
    (game_id, command_id) [pk, name: 'game_host_command_receipts_identity']
    (accepted_at, game_id) [name: 'game_host_command_receipts_cleanup']
  }

  checks {
    `octet_length(request_digest) = 32 AND length(btrim(command_name)) > 0` [name: 'game_host_command_receipts_request_shape']
    `controller_generation > 0 AND expected_version >= 0` [name: 'game_host_command_receipts_version_bounds']
    `result_version BETWEEN expected_version AND expected_version + 1` [name: 'game_host_command_receipts_result_version']
    `jsonb_typeof(result_data) = 'object'` [name: 'game_host_command_receipts_result_object']
  }

  Note: '''
    Accepted host-command/no-op receipt committed with its effect. Reauthenticate and
    fence controller authority, then check a game-scoped key/digest before stale-version
    validation: same request returns its result, a changed payload conflicts. No-op
    retries never renew inactivity or spend/award again. result_data is a bounded
    outcome/version/IDs, not a copied public/private game state, signed media URLs,
    bearer secrets or answer text. Clients resync the current authorized projection.
    Keep active-game receipts; post-terminal TTL cleanup does not remove durable
    start request identity, one-resolution keys or financial source uniqueness.
    Controller-secret exchange must remain retry-safe without plaintext credentials
    in this receipt. Feedback/contact use separate authenticated idempotent write paths.
  '''
}

Table question_feedback {
  game_id uuid [not null]
  board_position smallint [not null]
  question_position smallint [not null]
  host_account_id uuid [not null]
  vote feedback_vote [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (game_id, board_position, question_position) [pk, name: 'question_feedback_subject']
    (vote, updated_at, game_id) [name: 'question_feedback_staff_recent']
  }

  checks {
    `updated_at >= created_at` [name: 'question_feedback_update_order']
  }

  Note: '''
    One current host-only Like/Dislike per copied game question, editable after reveal
    including retained history. No reward/token effect or comment field. Slot FK
    identifies the exact starting question; host FK prevents other players voting.
    Endpoint checks account authority/reveal, not whether score commands remain open.
    Staff can inspect the retained snapshot and aggregate by source question identity.
    Retention/purge editing compatibility is pending Q85; no permanent feedback-only
    content copy is silently created. Do not count changed votes as extra submissions.
  '''
}

Table contact_submissions {
  id uuid [pk]
  request_key uuid [not null, unique]
  request_digest bytea [not null]
  account_id uuid
  kind contact_kind [not null]
  support_reason varchar(24)
  business_kind varchar(24)
  name text
  email text
  handle text
  message text
  rating smallint
  state contact_state [not null, default: 'open']
  created_at timestamptz [not null]
  closed_at timestamptz
  closed_by_staff_id uuid

  indexes {
    (state, created_at, id) [name: 'contact_submissions_staff_inbox']
    (account_id, created_at, id) [name: 'contact_submissions_account_cleanup']
  }

  checks {
    `octet_length(request_digest) = 32` [name: 'contact_submissions_request_digest']
    `message IS NULL OR length(message) <= 1000` [name: 'contact_submissions_message_bounds']
    `rating IS NULL OR rating BETWEEN 1 AND 5` [name: 'contact_submissions_rating_bounds']
    `(kind = 'support' AND support_reason IS NOT NULL AND support_reason IN ('technical', 'purchase', 'account') AND business_kind IS NULL AND email IS NOT NULL AND message IS NOT NULL AND length(btrim(message)) >= 5 AND rating IS NULL) OR (kind = 'business' AND business_kind IS NOT NULL AND business_kind IN ('business', 'influencer') AND support_reason IS NULL AND email IS NOT NULL AND message IS NOT NULL AND length(btrim(message)) >= 5 AND rating IS NULL) OR (kind = 'experience' AND support_reason IS NULL AND business_kind IS NULL AND (rating IS NOT NULL OR (message IS NOT NULL AND length(btrim(message)) > 0)))` [name: 'contact_submissions_form_shape']
    `(state = 'closed') = (closed_at IS NOT NULL)` [name: 'contact_submissions_closed_time']
    `(closed_at IS NULL) = (closed_by_staff_id IS NULL)` [name: 'contact_submissions_closing_actor']
    `closed_at IS NULL OR closed_at >= created_at` [name: 'contact_submissions_closing_order']
  }

  Note: '''
    Real persistent Support/Experience/Business inbox replacing browser-only storage.
    Super Admin may inspect/close; Content Admin has no financial/support inbox access.
    Normalize optional blanks, validate email syntax and bound all text on the server;
    user-entered contact email is not a verified player identity. Public submissions
    need abuse controls and key/digest retry handling without exposing stored PII.
    No automatic outbound mail, reply thread or ticketing integration is in scope.
    Personal-data/contact retention is separate from retained payment evidence.
  '''
}

Table public_pages {
  id uuid [pk]
  slug varchar(80) [not null, unique]
  content_schema_version smallint [not null, default: 1]
  content jsonb [not null]
  is_published boolean [not null, default: false]
  updated_by_staff_id uuid [not null]
  updated_at timestamptz [not null]

  checks {
    `slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'` [name: 'public_pages_slug_shape']
    `content_schema_version > 0 AND jsonb_typeof(content) = 'object'` [name: 'public_pages_content_shape']
  }

  Note: '''
    Admin-editable approved informational/legal/home page content using fixed renderer
    schemas and Arabic/optional Franco fields. Not arbitrary executable HTML/JS or a
    general page builder. Publication validates required fields/locales and ready public
    media. Content Admin/Super Admin can edit with audit. Slug is stable route identity;
    actual approved legal copy is supplied by the project, not invented by this schema.
    Images/covers use public_page_media references instead of untracked IDs inside JSON.
  '''
}

Table public_page_media {
  page_id uuid [not null]
  slot_key varchar(80) [not null]
  media_asset_id uuid [not null]
  alt_ar text
  alt_franco text

  indexes {
    (page_id, slot_key) [pk, name: 'public_page_media_slot']
    (media_asset_id, page_id) [name: 'public_page_media_asset_references']
  }

  checks {
    `length(btrim(slot_key)) > 0` [name: 'public_page_media_nonblank_slot']
  }

  Note: 'Typed template media slots for public pages. Publication requires ready public-scope assets and appropriate image alternative text. Private question originals must not accidentally become branding assets; publish a deliberate public copy when needed. Slot vocabulary/required roles belong to the page schema.'
}

Table site_settings {
  id smallint [pk, default: 1]
  settings_schema_version smallint [not null, default: 1]
  logo_asset_id uuid
  branding jsonb [not null]
  updated_by_staff_id uuid [not null]
  updated_at timestamptz [not null]

  checks {
    `id = 1 AND settings_schema_version > 0` [name: 'site_settings_singleton_version']
    `jsonb_typeof(branding) = 'object'` [name: 'site_settings_branding_object']
  }

  Note: '''
    One validated branding/contact/social configuration, including approved colors and
    localized labels. Logo FK participates in asset retention. No API credentials or
    arbitrary scripts in this public data. Branding edits do not change fixed launch
    gameplay rules (six people, two teams, 36 tiles, 60-second answering clock); those
    accepted rules must not silently change through a generic JSON dashboard field.
  '''
}

Table outbox_events {
  id uuid [pk]
  deduplication_key varchar(160) [not null, unique]
  topic varchar(80) [not null]
  resource_kind varchar(48) [not null]
  resource_id uuid [not null]
  payload jsonb [not null, default: `'{}'::jsonb`]
  state work_state [not null, default: 'pending']
  attempt_count integer [not null, default: 0]
  max_attempts smallint [not null, default: 10]
  available_at timestamptz [not null]
  lease_token uuid
  lease_until timestamptz
  created_at timestamptz [not null]
  finished_at timestamptz
  last_error_code varchar(80)

  indexes {
    (state, available_at, id) [name: 'outbox_events_pending_work']
    (state, lease_until, id) [name: 'outbox_events_stale_leases']
    (resource_kind, resource_id, created_at, id) [name: 'outbox_events_resource_history']
  }

  checks {
    `length(btrim(topic)) > 0 AND length(btrim(resource_kind)) > 0` [name: 'outbox_events_nonblank_routing']
    `jsonb_typeof(payload) = 'object'` [name: 'outbox_events_payload_object']
    `max_attempts > 0 AND attempt_count BETWEEN 0 AND max_attempts` [name: 'outbox_events_attempt_bounds']
    `(state = 'running') = (lease_token IS NOT NULL)` [name: 'outbox_events_lease_token_pair']
    `(lease_token IS NULL) = (lease_until IS NULL)` [name: 'outbox_events_lease_time_pair']
    `state <> 'running' OR attempt_count > 0` [name: 'outbox_events_claim_attempt']
    `(state IN ('succeeded', 'dead')) = (finished_at IS NOT NULL)` [name: 'outbox_events_finish_pair']
    `finished_at IS NULL OR finished_at >= created_at` [name: 'outbox_events_finish_order']
  }

  Note: '''
    Durable post-commit work inside the existing NestJS/PostgreSQL topology: game
    version-change hints, media processing/cleanup, receipt processing/inquiry,
    external auth revocation/deletion and account cleanup. Commit with the source
    transition; bounded workers claim with SKIP LOCKED, commit a lease, perform I/O
    outside locks, then conditionally acknowledge the matching lease token. Recover
    expired leases and alert on dead work. Retrying does not imply provider-native
    exactly-once creation: unknown payment effects require inquiry/reconciliation.
    Routing target is explicit generic metadata, not a polymorphic FK; each topic
    validates its bounded payload/resource and reloads authoritative state. Store
    IDs/config versions only, not secrets, signed URLs, raw PII or question answers.
    Media writes use fresh immutable keys/conditional creation before ready state.
    Game fan-out carries a version hint; authorized clients resync state after gaps.
    No permanent per-socket event log or Redis service is required at launch.
  '''
}

