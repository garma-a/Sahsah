{
  "name": "@sahsah/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "esbuild"
    ],
    "overrides": {
      "@tiptap/core": "2.27.3",
      "@tiptap/pm": "2.27.3",
      "@tiptap/starter-kit": "2.27.3"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/database/cli.js migrate",
    "db:status": "npm run build && node --env-file-if-exists=.env dist/database/cli.js status",
    "db:grant-runtime": "npm run build && node --env-file-if-exists=.env dist/database/cli.js grant-runtime",
    "test:database": "npm run build && node --test tests/database/*.test.mjs"
  },
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "adminjs": "7.8.17",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-formidable": "1.2.0",
    "express-session": "1.19.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
