PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
# Platform proxies in front of the API (Railway: 1). 0 trusts no forwarded address,
# so behind a proxy every player would share one rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# PostgreSQL 18; the API must use a separate, restricted runtime role.
# Empty is allowed only in development/test; /api/health/ready then returns 503.
# Local Docker database (docker compose up -d):
#   DATABASE_URL=postgresql://sahsah_app:sahsah_local@localhost:5433/sahsah
#   MIGRATION_DATABASE_URL=postgresql://sahsah_owner:sahsah_local@localhost:5433/sahsah
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_TRANSACTION_IDLE_TIMEOUT_MS=10000

# Supply only to the explicit migration/provisioning commands, never to the API deployment.
# Example format: postgresql://sahsah_owner:PASSWORD@localhost:5432/sahsah
MIGRATION_DATABASE_URL=
DATABASE_RUNTIME_ROLE=sahsah_app

# The dashboard shares this backend at /admin. Enable after setting credentials.
ADMIN_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# At least 32 characters; generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Gameplay remains disabled until upstream integrations and limits are verified.
GAMEPLAY_ENABLED=false
GAMEPLAY_JOIN_BASE_URL=http://localhost:3000/join
# Existing issuer must provide a signed, issuer-controlled account_id UUID claim.
GAMEPLAY_IDENTITY_JWKS_URL=
GAMEPLAY_IDENTITY_ISSUER=
GAMEPLAY_IDENTITY_AUDIENCE=
# Preview before login exists (ADR 0017): a browser that sends the passcode gets
# its own host account. Leave empty outside the preview deployment and local
# development; never combine with GAMEPLAY_IDENTITY_JWKS_URL.
GAMEPLAY_PREVIEW_PASSCODE=
# At least 32 characters; generate with: openssl rand -hex 32
GAMEPLAY_PREVIEW_SECRET=
# Media storage. Local development: a directory served by this API (not allowed
# in production). Deployment: leave it empty and fill in R2.
GAMEPLAY_LOCAL_MEDIA_DIR=
R2_ACCOUNT_ID=
# Private question media; the API key needs Object Read on this bucket only.
R2_GAMEPLAY_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public category covers: the bucket's public address, e.g. https://pub-….r2.dev
GAMEPLAY_PUBLIC_MEDIA_BASE_URL=
# Content scripts only (content:seed); never set on the API deployment.
R2_PUBLIC_BUCKET=
R2_IMPORT_ACCESS_KEY_ID=
R2_IMPORT_SECRET_ACCESS_KEY=
# Production: highest passing measured envelope, before the 85% headroom.
GAMEPLAY_CAPACITY_ROOMS=
GAMEPLAY_CAPACITY_MEMBERS=
GAMEPLAY_CAPACITY_GAMES=
# Bounded HTTP source/verified-subject rates per second and burst tokens.
GAMEPLAY_HTTP_IP_RATE=100
GAMEPLAY_HTTP_IP_BURST=240
GAMEPLAY_HTTP_SUBJECT_RATE=60
GAMEPLAY_HTTP_SUBJECT_BURST=240
# Needed when API cgroups expose no finite CPU/RAM limit.
GAMEPLAY_API_CPU_LIMIT_CORES=
GAMEPLAY_API_MEMORY_LIMIT_BYTES=
# Required DB container/provider exporter and its exact effective limits.
GAMEPLAY_DB_PRESSURE_URL=
GAMEPLAY_DB_PRESSURE_TOKEN=
GAMEPLAY_DB_CPU_LIMIT_CORES=
GAMEPLAY_DB_MEMORY_LIMIT_BYTES=

# Defaults: info in production, debug locally; tests always use silent.
LOG_LEVEL=debug
