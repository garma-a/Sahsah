# Public base of the Sahsah API, including /api. The WebSocket address (/api/v1/realtime) is derived from it.
# Local development: run the API (web_app/backend, GAMEPLAY_ENABLED=true) and allow http://localhost:3000 in its CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Optional: Cloudflare Web Analytics beacon token (Cloudflare dashboard > Web Analytics > the site's snippet).
# The beacon script is added to every page only when this is set. Inlined at build time.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
